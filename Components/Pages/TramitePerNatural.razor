@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@page "/Tramitar/TPersonaNatural"
 
@layout MainLayout

@inject IJSRuntime JS
@inject Services.SessionService SessionService
@inherits PageBase 
@inject ProtectedSessionStorage SessionStorage
@inject HttpClient Http 
@inject IConfiguration Configuration
@inject DocumentoAdjuntoServices ArchivoPrincipalService // Documento Adjunto



<div class="ux-bg">
    <div class="ux-container">

        <div class="ux-header">
            <div class="ux-badge-top">Mesa de Partes Virtual</div>
             
            <h1>Persona Natural</h1>
            <p class="ux-description">
                Completa todos los campos para registrar tu documento.
            </p>
        </div>

        <div class="alert alert-warning border-warning shadow-sm mb-4" role="alert" style="background-color: #fff3cd; border-left: 5px solid #ffc107; padding: 15px; border-radius: 4px;">
            <div style="display: flex; gap: 10px; align-items: flex-start;">
                <span style="font-size: 1.5rem; line-height: 1;">⚠️</span>
                <div style="font-size: 0.95rem; color: #856404;">
                    <strong>¡IMPORTANTE!</strong> Todo documento dirigido al <strong>Órgano de Control Institucional de AGRO RURAL</strong> debe ser canalizado exclusivamente a través de la Mesa de Partes de la <strong>CONTRALORÍA GENERAL DE LA REPÚBLICA</strong>, mediante el siguiente enlace:
                    <a href="https://mesadepartesvirtual.contraloria.gob.pe/mpvirtual/" target="_blank" rel="noopener noreferrer" style="font-weight: bold; color: #533f03; text-decoration: underline;">
                        https://mesadepartesvirtual.contraloria.gob.pe/mpvirtual/
                    </a>
                </div>
            </div>
        </div>

         
        <div class="ux-card-form">
            <h2>I. DATOS DEL DOCUMENTO</h2>
            <div class="ux-grid-form">
                <div class="ux-field">
                    <label>Tipo de Documento *</label>
                    <select @bind="formulario.ICodTipoDoc" @bind:after="LimpiarErrorTipoDocTramite">
                        <option value="0">--SELECCIONAR--</option>
                        @foreach (var doc in listaTiposDocumento)
                        {
                            <option value="@doc.iCodTipoDoc">@doc.vNombreTipoDoc</option>
                        }
                    </select>
                    @if (!string.IsNullOrEmpty(errorTipoDocTramite))
                    {
                        <span class="ux-error">@errorTipoDocTramite</span>
                    }
                </div>

                <div class="ux-field">
                    <label>Nro Documento *</label>
                    <input placeholder="Ej: 001-2024" @bind="formulario.VNroDoc" @bind:after="LimpiarErrorNroDocTramite" style="text-transform: uppercase;" />
                    @if (!string.IsNullOrEmpty(errorNroDocTramite))
                    {
                        <span class="ux-error">@errorNroDocTramite</span>
                    }
                </div>

                <div class="ux-field">
                    <label>Folio *</label>
                    <input @bind="formulario.VNroPagFolios" @bind:after="LimpiarErrorFolios" placeholder="Ej: 15" onkeypress="return event.charCode >= 48 && event.charCode <= 57" />
                    @if (!string.IsNullOrEmpty(errorFolios))
                    {
                        <span class="ux-error">@errorFolios</span>
                    }
                </div>

                <div class="ux-field">
                    <label>Fecha del Documento *</label>
                    <input type="date" @bind="formulario.DFecDoc" @bind:after="LimpiarErrorFechaDoc" />
                    @if (!string.IsNullOrEmpty(errorFechaDoc))
                    {
                        <span class="ux-error">@errorFechaDoc</span>
                    }
                </div>

                <div class="ux-field full">
                    <label>Asunto / Sumilla *</label>
                    <textarea maxlength="255" @bind="formulario.VNombreAsunto" @bind:after="LimpiarErrorAsunto" placeholder="Ingrese el resumen o asunto del documento..." style="text-transform: uppercase;"></textarea>
                    @if (!string.IsNullOrEmpty(errorAsunto))
                    {
                        <span class="ux-error">@errorAsunto</span>
                    }
                </div>

                <div class="ux-field full">
                    <label>Referencia</label>
                    <input @bind="formulario.VReferencia" placeholder="Ej: Exp. Anterior N° 4521" style="text-transform: uppercase;" />
                </div>
            </div>
        </div>

        <div class="ux-card-form">
            <h2>Documento adjunto</h2>

            <!-- InputFile condicionado: si no hay archivo válido, se muestra el selector -->
            @if (archivo.Contenido == null || archivo.Contenido.Length == 0)
            {
                <div class="ux-upload-area">
                    <InputFile @key="inputKey" OnChange="OnFileSelected" accept=".pdf" class="form-control" />
                </div>
            }

            <p class="ux-file-hint">
                (Peso máximo: 50MB. Solo se permite archivos en formato PDF)
            </p>

            <!-- La tarjeta verde y el visor solo se pintan si el archivo pasó todas las validaciones -->
            @if (archivo != null && archivo.Contenido != null && archivo.Contenido.Length > 0)
            {
                <div class="ux-file-info-container" style="display: flex; justify-content: space-between; align-items: center; background: #e8f5e9; padding: 10px; border-radius: 8px;">
                    <div class="ux-file-info" style="font-weight: 600; color: #2e7d32;">
                        ✅ <span>@archivo.Nombre</span> (@archivo.Tamano)
                    </div>
                    <button type="button" class="ux-btn-delete" @onclick="RemoverArchivo" style="background: none; border: none; cursor: pointer; color: #d33; font-weight: bold;">
                        ❌ Quitar
                    </button>
                </div>

                <div class="ux-pdf-preview" style="margin-top: 15px; height: 400px; border: 1px solid #ddd;">
                    <iframe src="@($"data:application/pdf;base64,{Convert.ToBase64String(archivo.Contenido)}")" width="100%" height="100%"></iframe>
                </div>
            }
        </div>

        <div class="ux-card-form">
            <h2>Anexos</h2>

            <!-- InputFile múltiple con el diseño unificado -->
            <div class="ux-upload-area">
                <InputFile @key="inputAnexosKey"
                           multiple
                           accept=".pdf"
                           class="form-control"
                           OnChange="HandleFilesSelected" />
            </div>

            @if (!string.IsNullOrEmpty(errorArchivo))
            {
                <div class="ux-error" style="color: red; margin: 10px 0;">
                    <strong>¡Atención!</strong> @errorArchivo
                </div>
            }

            <p class="ux-file-hint">
                (Peso máximo de cada archivo: 20MB) (Formato permitido: <b>PDF</b>) (Número máximo de anexos: 10)
            </p>

            <div class="ux-table-wrapper" style="margin-top: 15px;">
                <table class="ux-table">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Tamaño</th>
                            <th style="text-align: center;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (archivos.Any())
                        {
                            @foreach (var archi in archivos)
                            {
                                <tr>
                                    <td>📄 @archi.Nombre</td>
                                    <td>@archi.Tamano</td>
                                    <td style="text-align: center; display: flex; gap: 8px; justify-content: center;">
                                        <!-- Botón de Vista Previa -->
                                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => VerPreviewAnexo(archi)" style="padding: 2px 10px; font-size: 0.85rem;">
                                            Ver
                                        </button>
                                        <!-- Botón Eliminar -->
                                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => EliminarArchivo(archi)" style="padding: 2px 10px; font-size: 0.85rem;">
                                            Eliminar
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="ux-empty" style="text-align: center; color: #64748b; padding: 20px;">
                                    No hay archivos anexos cargados
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <hr class="ux-divider" />

            <div class="ux-nota">
                <strong>Nota:</strong><br />
                El número del expediente de la presente solicitud será notificado al correo electrónico consignado en el presente formulario.
            </div>

            <hr class="ux-divider" />

            <!-- BLOQUE DE CHECKBOXES OBLIGATORIOS -->
            <DeclaracionesLegales 
                                AceptaTerminos="aceptaTerminos" 
                                AceptaTerminosChanged="(valor => aceptaTerminos = valor)"
                                AceptaDatosPersonales="aceptaDatosPersonales" 
                                AceptaDatosPersonalesChanged="(valor => aceptaDatosPersonales = valor)" />
            <!-- FIN DEL BLOQUE -->

            <div class="ux-actions">
                <button class="ux-button-secondary" @onclick="ManejarVolver">
                    ← Volver
                </button>

                <button class="ux-btn-primary" @onclick="Finalizar">
                    Enviar solicitud
                </button>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(previewUrl))
        {
            <div class="ux-modal-overlay" @onclick="CerrarPreview">
                <div class="ux-modal-content" @onclick:stopPropagation="true">
                    <button class="ux-close" @onclick="CerrarPreview">✖</button>
                    <div class="ux-iframe-wrapper">
                        <iframe src="@previewUrl"></iframe>
                    </div>
                </div>
            </div>
        }

    </div>
</div>

  
@code {

    // Parámetro para notificar al padre que el usuario quiere volver
    [Parameter] public EventCallback OnVolver { get; set; }

    private async Task ManejarVolver()
    {
        // Intentamos notificar al padre primero
        if (OnVolver.HasDelegate)
        {
            await OnVolver.InvokeAsync();
        }
        else
        {
            // Si no hay padre escuchando (caso de error), redirigimos a la ruta segura
            // Nav.NavigateTo("/Tramitar", true);
            Ir($"/Tramitar", true);

        }
    }
    private TramitePersNaturalDto formulario = new();
    private List<TipoDocumento> listaTiposDocumento = new();

    protected override async Task OnInitializedAsync()
    {
        // Carga los tipos de documento al abrir la página
        listaTiposDocumento = await Http.GetFromJsonAsync<List<TipoDocumento>>("api/documentos/tipos-documento"); 
    }

    private string errorTipoDocTramite = "";
    private string errorNroDocTramite = "";
    private string errorFolios = "";
    private string errorFechaDoc = "";
    private string errorAsunto = "";

    private bool ValidarFormularioDocumentos()
    {
        // 1. Limpiar errores previos de la sección de documentos
        errorTipoDocTramite = "";
        errorNroDocTramite = "";
        errorFolios = "";
        errorFechaDoc = "";
        errorAsunto = "";

        bool esValido = true;

        // 2. Validar Tipo de Documento del Trámite
        if (formulario.ICodTipoDoc <= 0)
        {
            errorTipoDocTramite = "Debe seleccionar un tipo de documento.";
            esValido = false;
        }

        // 3. Validar Nro Documento
        if (string.IsNullOrWhiteSpace(formulario.VNroDoc))
        {
            errorNroDocTramite = "El número de documento es obligatorio.";
            esValido = false;
        }

        // 4. Validar Folios
        if (string.IsNullOrWhiteSpace(formulario.VNroPagFolios))
        {
            errorFolios = "El número de folios es obligatorio.";
            esValido = false;
        }

        // 5. Validar Fecha del Documento
        if (formulario.DFecDoc == default)
        {
            errorFechaDoc = "La fecha del documento es obligatoria.";
            esValido = false;
        }

        // 6. Validar Asunto / Sumilla
        if (string.IsNullOrWhiteSpace(formulario.VNombreAsunto))
        {
            errorAsunto = "El asunto o sumilla es obligatorio.";
            esValido = false;
        }

        // Refrescar la pantalla para mostrar los textos rojos si hay errores
        StateHasChanged();

        return esValido;
    }

    private void LimpiarErrorTipoDocTramite()
    {
        if (formulario.ICodTipoDoc > 0) errorTipoDocTramite = "";
    }

    private void LimpiarErrorNroDocTramite()
    {
        if (!string.IsNullOrWhiteSpace(formulario.VNroDoc)) errorNroDocTramite = "";
    }

    private void LimpiarErrorFolios()
    {
        if (!string.IsNullOrWhiteSpace(formulario.VNroPagFolios)) errorFolios = "";
    }

    private void LimpiarErrorFechaDoc()
    {
        if (formulario.DFecDoc != default) errorFechaDoc = "";
    }

    private void LimpiarErrorAsunto()
    {
        if (!string.IsNullOrWhiteSpace(formulario.VNombreAsunto)) errorAsunto = "";
    }
    // ******************************************************************
    // DOCUMENTOS ADJUNTOS
    // ******************************************************************
    private ArchivoAdjunto archivo = new();
    private string error = "";
    private int inputKey = 0;

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var resultado = await ArchivoPrincipalService.ProcesarArchivoSeleccionadoAsync(e);

        if (resultado != null)
        {
            archivo = resultado;
            error = string.Empty;
        }
        else
        {
            RemoverArchivo();
        }
    }

    private void RemoverArchivo()
    {
        archivo = new();
        inputKey++;
        StateHasChanged();
    }

    // ************
    // ANEXOS
    // ************
    private List<ArchivoAdjunto> archivos = new();
    private string errorArchivo = "";
    private int inputAnexosKey = 0;
    private string? previewUrl; // Variable que alimenta el iframe del modal general

    private async Task HandleFilesSelected(InputFileChangeEventArgs e)
    {
        errorArchivo = string.Empty;

        // Llama al servicio global que ya actualizamos previamente
        var resultado = await ArchivoPrincipalService.ProcesarAnexosSeleccionadosAsync(e, archivos);

        if (resultado != null)
        {
            archivos = resultado;
        }

        inputAnexosKey++; // Resetea el control input multiple
        StateHasChanged();
    }

    private void VerPreviewAnexo(ArchivoAdjunto archi)
    {
        if (archi.Contenido != null && archi.Contenido.Length > 0)
        {
            previewUrl = $"data:application/pdf;base64,{Convert.ToBase64String(archi.Contenido)}";
            StateHasChanged();
        }
    }

    private void EliminarArchivo(ArchivoAdjunto archi)
    {
        archivos.Remove(archi);
        StateHasChanged();
    }

    private void CerrarPreview()
    {
        previewUrl = null;
        StateHasChanged();
    }

    private List<ArchivoAdjunto> listaAnexos = new List<ArchivoAdjunto>();

    private async Task MostrarMensajeExito(RegistroDocumentoResponseTPN resultadoBD)
    {
        string emailUsuario = SessionService.UserSession?.VEmail ?? "No disponible";

        string mensajeSwal = "<div style='text-align: center; font-family: Arial, sans-serif;'>" +
          "<div style='background-color: #35af72; margin: -1.25em -1.25em 20px -1.25em; padding: 25px 10px; border-top-left-radius: 5px; border-top-right-radius: 5px;'>" +
              "<img src='https://www.gob.pe/rails/active_storage/representations/redirect/eyJfcmFpbHMiOnsiZGF0YSI6NDk2ODQ0LCJwdXIiOiJibG9iX2lkIn19--1fc9a7807cf6c726e857b951ca1a374a8414a140/eyJfcmFpbHMiOnsiZGF0YSI6eyJmb3JtYXQiOiJwbmciLCJyZXNpemVfdG9fbGltaXQiOltudWxsLDQ4XX0sInB1ciI6InZhcmlhdGlvbiJ9fQ==--830247c4bafe7cadca50817d8559bf1a09e3aa28/paga%20gob.pe.png' style='max-height: 45px; width: auto;' alt='Logo AGRO RURAL' />" +
              "<h3 style='color: #ffffff; margin: 12px 0 0 0; font-size: 1.3rem; font-weight: 600;'>¡Documento Registrado!</h3>" +
          "</div>" +
          "<p style='color: #555555; font-size: 0.95rem; line-height: 1.5; padding: 0 10px;'>Estimado usuario, su documentación ha sido ingresada de forma satisfactoria en la Mesa de Partes Virtual.</p>" +
          "<div style='background-color: #f4f9f5; border: 1px dashed #35af72; border-radius: 6px; padding: 15px; margin: 20px 10px; text-align: left;'>" +
              "<div style='margin-bottom: 10px; display: flex; justify-content: space-between; align-items: center;'>" +
                  "<span style='color: #666666; font-size: 0.85rem; font-weight: bold; text-transform: uppercase;'>Código de Trámite:</span>" +
                  "<span style='color: #006432; font-family: monospace; font-size: 1.15rem; font-weight: bold; background: #e8f5e9; padding: 3px 8px; border-radius: 4px;'>" + (resultadoBD?.VAutoGenerado ?? "N/A") + "</span>" +
              "</div>" +
              "<div style='display: flex; justify-content: space-between; align-items: center;'>" +
                  "<span style='color: #666666; font-size: 0.85rem; font-weight: bold; text-transform: uppercase;'>Mail de Seguimiento:</span>" +
                  "<span style='color: #333333; font-size: 0.9rem; font-weight: 600; text-align: right; max-width: 180px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;'>" + emailUsuario + "</span>" +
              "</div>" +
          "</div>" +
          "<div style='font-size: 0.8rem; color: #666666; background-color: #fff8e7; border-left: 4px solid #f39c12; padding: 10px; margin: 0 10px 10px 10px; text-align: left; border-radius: 4px;'>📌 <strong>Notificación Enviada:</strong> Se ha despachado el cargo electrónico con el acuse de recibo a la dirección señalada.</div>" +
      "</div>";

        var result = await JS.InvokeAsync<object>("Swal.fire", new
        {
            html = mensajeSwal,
            icon = "success", // Puedes poner "success" para que aparezca el check verde
            confirmButtonText = "Finalizar y Volver",
            confirmButtonColor = "#35af72",
            allowOutsideClick = false,
            allowEscapeKey = false,
            timer = 15000,
            timerProgressBar = true
        });

        // 2. Al llegar aquí, el usuario ya hizo click o el timer expiró.
        // Ahora realizamos la navegación de forma segura.
        // Nav.NavigateTo("/");
    }

    private bool aceptaTerminos = false;
    private bool aceptaDatosPersonales = false;

    async Task Finalizar()
    {
        ValidarFormularioDocumentos();
         
        // 2. VALIDACIÓN DEL DOCUMENTO PRINCIPAL        
        if (archivo == null || archivo.Contenido == null || archivo.Contenido.Length == 0)
        {
            await JS.InvokeVoidAsync("Swal.fire", new
            {
                html = $@"
                        <div style='text-align: left; padding: 10px 5px; font-family: system-ui, -apple-system, sans-serif;'>
                            <!-- Cabecera con Icono -->
                            <div style='display: flex; align-items: center; gap: 14px; margin-bottom: 20px;'>
                                <div style='background-color: #fef2f2; color: #dc2626; width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 24px; flex-shrink: 0; box-shadow: 0 2px 4px rgba(220, 38, 38, 0.1);'>
                                    📁
                                </div>
                                <div>
                                    <h3 style='margin: 0; font-size: 18px; font-weight: 700; color: #1e293b;'>Documento Obligatorio</h3>
                                    <p style='margin: 2px 0 0 0; font-size: 13px; color: #64748b;'>Validación de Requisitos</p>
                                </div>
                            </div>

                            <!-- Descripción -->
                            <p style='font-size: 14px; color: #475569; line-height: 1.5; margin-bottom: 20px;'>
                                Para proceder con el registro en la Mesa de Partes Virtual, es un requisito indispensable adjuntar el documento principal del trámite.
                            </p>

                            <!-- Tarjeta de Alerta -->
                            <div style='background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 16px; margin-bottom: 20px;'>
                                <div style='display: flex; justify-content: space-between; align-items: center; font-size: 14px;'>
                                    <span style='color: #64748b;'>Estado actual:</span>
                                    <span style='font-weight: 600; color: #dc2626; background: #fee2e2; padding: 2px 8px; border-radius: 6px;'>Falta documento principal</span>
                                </div>
                            </div>

                            <!-- Nota de ayuda -->
                            <div style='display: flex; align-items: center; gap: 8px; font-size: 12px; color: #b91c1c; background: #fef2f2; padding: 10px 12px; border-radius: 8px;'>
                                <span>📌</span>
                                <span>Por favor, seleccione y cargue su archivo principal antes de continuar.</span>
                            </div>
                        </div>
                    ",
                showConfirmButton = true,
                confirmButtonText = "Entendido",
                confirmButtonColor = "#1e293b",
                backdrop = "rgba(15, 23, 42, 0.5)",
                customClass = new
                {
                    popup = "rounded-2xl shadow-xl border border-slate-100"
                }
            });
            return;
        }

        // Validación obligatoria de AMBOS checkboxes independientes        
        if (!aceptaTerminos || !aceptaDatosPersonales)
        {
            await JS.InvokeVoidAsync("Swal.fire", new
            {
                html = $@"
                        <div style='text-align: left; padding: 10px 5px; font-family: system-ui, -apple-system, sans-serif;'>
                            <!-- Cabecera con Icono -->
                            <div style='display: flex; align-items: center; gap: 14px; margin-bottom: 20px;'>
                                <div style='background-color: #eff6ff; color: #1d4ed8; width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 24px; flex-shrink: 0; box-shadow: 0 2px 4px rgba(29, 78, 216, 0.1);'>
                                    ⚖️
                                </div>
                                <div>
                                    <h3 style='margin: 0; font-size: 18px; font-weight: 700; color: #1e293b;'>Conformidad Requerida</h3>
                                    <p style='margin: 2px 0 0 0; font-size: 13px; color: #64748b;'>Validación Legal y Términos</p>
                                </div>
                            </div>

                            <!-- Descripción -->
                            <p style='font-size: 14px; color: #475569; line-height: 1.5; margin-bottom: 20px;'>
                                Para continuar con su trámite en la Mesa de Partes Virtual, es necesario que nos otorgue su conformidad con las normativas vigentes.
                            </p>

                            <!-- Tarjeta de Requisitos Legales -->
                            <div style='background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 16px; margin-bottom: 20px;'>
                                <div style='font-size: 13px; color: #334155; margin-bottom: 8px; display: flex; align-items: center; gap: 8px;'>
                                    <span style='color: #2563eb;'>✔</span> Términos y Condiciones de Uso
                                </div>
                                <div style='font-size: 13px; color: #334155; display: flex; align-items: center; gap: 8px;'>
                                    <span style='color: #2563eb;'>✔</span> Tratamiento de Datos Personales (Ley N° 29733)
                                </div>
                            </div>

                            <!-- Nota de ayuda -->
                            <div style='display: flex; align-items: center; gap: 8px; font-size: 12px; color: #1d4ed8; background: #eff6ff; padding: 10px 12px; border-radius: 8px;'>
                                <span>📌</span>
                                <span>Por favor, marque las casillas correspondientes antes de enviar su solicitud.</span>
                            </div>
                        </div>
                    ",
                showConfirmButton = true,
                confirmButtonText = "Entendido",
                confirmButtonColor = "#1e293b",
                backdrop = "rgba(15, 23, 42, 0.5)",
                customClass = new
                {
                    popup = "rounded-2xl shadow-xl border border-slate-100"
                }
            });
            return;
        }

        try
        {
            formulario.ICodPer = SessionService.UserSession.ICodPer;
            formulario.VEmail = SessionService.UserSession.VEmail;

            // ¡IMPORTANTE! Asignar los estados de los checkboxes al formulario antes de enviarlo
            formulario.AceptaTerminos = aceptaTerminos;
            formulario.AceptaDatosPersonales = aceptaDatosPersonales;

            // 2. Registro Principal            
            formulario.VRutaDoc = await SubirArchivo(archivo.Nombre, archivo.Contenido);
            formulario.BTipo = false; // 0 = Principal

            var response = await Http.PostAsJsonAsync("api/documentos/registro-tramite-natural", formulario);
            if (!response.IsSuccessStatusCode) throw new Exception(await response.Content.ReadAsStringAsync());

            // Mantenemos esta variable como referencia única            
            var resultadoPrincipal = await response.Content.ReadFromJsonAsync<RegistroDocumentoResponseTPN>();

            // 3. Registro Anexos (Opcional)            if (archivos != null && archivos.Any())
            {
                foreach (var item in archivos)
                {
                    var rutaAnexo = await SubirArchivo(item.Nombre, item.Contenido);
                    var anexo = new TramitePersNaturalDto // Asegúrate de usar tu DTO principal o el que corresponda para el anexo
                    {
                        ICodPer = formulario.ICodPer,
                        VEmail = formulario.VEmail,
                        ICodTipoDoc = formulario.ICodTipoDoc,
                        VNroDoc = formulario.VNroDoc,
                        VNroPagFolios = formulario.VNroPagFolios,
                        DFecDoc = formulario.DFecDoc,
                        VNombreAsunto = formulario.VNombreAsunto,
                        VReferencia = formulario.VReferencia,
                        VRutaDoc = rutaAnexo,
                        BTipo = true, // 1 = Anexo                        
                        ICodAsunto = resultadoPrincipal!.ICodAsunto,
                        AceptaTerminos = aceptaTerminos,
                        AceptaDatosPersonales = aceptaDatosPersonales
                    };
                    await Http.PostAsJsonAsync("api/documentos/registro-tramite-natural", anexo);
                }
            }

            // 4. Éxito            
            await MostrarMensajeExito(resultadoPrincipal!);
            Ir($"/Tramitar");

        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("Swal.fire", "Error al Registrar", ex.Message, "error");
        }
    }

    // Método auxiliar para evitar duplicar código de subida
    private async Task<string> SubirArchivo(string nombre, byte[] contenido)
    {
        using var content = new MultipartFormDataContent();
        using var fileContent = new ByteArrayContent(contenido);

        // El nombre del campo "archivo" debe coincidir con lo que espera tu API
        content.Add(fileContent, "archivo", nombre);

        var response = await Http.PostAsync("api/archivos/subir", content);
        if (!response.IsSuccessStatusCode) throw new Exception($"Error al subir {nombre}");

        var res = await response.Content.ReadFromJsonAsync<RespuestaRuta>();
        return res!.ruta;
    }


