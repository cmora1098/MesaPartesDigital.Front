@layout MainLayout
@page "/VerTramite/{idAsunto:int}"
@inject HttpClient Http
@inherits PageBase
@inject IJSRuntime JSRuntime
@inject IConfiguration Configuration

<PageTitle>Mesa de Partes Virtual - Detalle del Trámite</PageTitle>

<div class="ux-bg-t">
    <div class="ux-container-t">
        <div class="ux-hero-t">
            <div class="ux-badge-top-t" style="background-color: #0284c7; color: white;">Vista Previa / Detalle</div>
            <h1>CÓDIGO DE TRÁMITE: @(tramite?.CodigoTramite ?? idAsunto.ToString())</h1>
            <p class="ux-description-t">Consulta la información registrada y el estado actual de tu expediente.</p>
        </div>

        @if (tramite != null)
        {
            <!-- Información del Expediente (Solo Lectura) -->
            <div class="ux-card-form">
                <h2>Información del Expediente</h2>
                <div class="form-grid-t">
                    <div class="form-group-t">
                        <label>Tipo de Trámite</label>
                        <select @bind="tramite.TipoTramite" class="ux-select" disabled>
                            <option value="0">Seleccione...</option>
                            <option value="1">Persona Jurídica</option>
                            <option value="2">Persona Natural</option>
                        </select>
                    </div>

                    @if (tramite.TipoTramite == 1)
                    {
                        <div class="form-group-t animate-fade-in span-two">
                            <label>RUC</label>
                            <div class="ux-input-group">
                                <input @bind="tramite.RucTramite" disabled />
                            </div>
                        </div>
                    }

                    <div class="form-group-t">
                        <label>Correo de Seguimiento</label>
                        <input type="email" class="form-control-t" @bind="tramite.CorreoTramite" disabled />
                    </div>
                    <div class="form-group-t">
                        <label>Dependencia</label>
                        <input type="text" class="form-control-t" value="@tramite.NombreDependencia" disabled />
                    </div>
                    <div class="form-group-t">
                        <label>Estado Actual</label>
                        <div class="estado-display">@tramite.EstadoTramite</div>
                    </div>
                    <div class="form-group-t">
                        <label>Fecha de Creación</label>
                        <div class="estado-display">@tramite.Fecha</div>
                    </div>
                    <div class="form-group-t">
                        <label>CUT</label>
                        <div class="estado-display @(string.IsNullOrEmpty(tramite.CUTTramite) ? "text-muted fst-italic" : "")">
                            @(string.IsNullOrEmpty(tramite.CUTTramite) ? "NO CONTIENE CUT ACTUALMENTE" : tramite.CUTTramite)
                        </div>
                    </div>
                </div>
            </div>

            <!-- Información del Documento (Solo Lectura) -->
            <div class="ux-card-form">
                <h2>Información del Documento</h2>
                <div class="form-grid-t">
                    <div class="form-group-t span-two">
                        <label>Asunto / Sumilla</label>
                        <textarea class="form-control-t" @bind="tramite.AsuntoTramite" disabled style="resize: vertical; min-height: 80px;"></textarea>
                    </div>
                    <div class="form-group-t">
                        <label>Tipo de Documento</label>
                        <select @bind="tramite.iCodTipoDoc" disabled>
                            <option value="0">--SELECCIONAR--</option>
                            @foreach (var doc in listaTiposDocumento)
                            {
                                <option value="@doc.iCodTipoDoc">@doc.vNombreTipoDoc</option>
                            }
                        </select>
                    </div>
                    <div class="form-group-t">
                        <label>Nro Documento</label>
                        <input @bind="tramite.NroDocumento" disabled />
                    </div>
                    <div class="form-group-t">
                        <label>Folio</label>
                        <input @bind="tramite.FoliosDocumento" disabled />
                    </div>
                    <div class="form-group-t">
                        <label>Fecha del Documento</label>
                        <input type="date" @bind="tramite.FechaDocumento" disabled />
                    </div>
                    <div class="form-group-t span-two">
                        <label>Referencia</label>
                        <input @bind="tramite.RefDocumento" disabled />
                    </div>
                </div>
            </div>

            <!-- Módulo Unificado de Visualización de Documentos -->
            <div class="ux-card-form">
                <h2>Gestión de Documentos Adjuntos</h2>

                <div class="doc-header-section">
                    <p class="text-muted mb-0">Navegación rápida y visualización de archivos asociados al trámite</p>
                </div>

                <!-- GUÍA VISUAL -->
                <div class="doc-guide-alert">
                    <div class="doc-guide-title">
                        <span>💡</span> <span>Guía de uso:</span>
                    </div>
                    <ul class="doc-guide-list">
                        <li>Haga clic en cualquier tarjeta lateral para cargar el archivo en el visor principal.</li>
                        <li>El estado <span class="doc-badge-active-tag">Activo</span> indica el documento que está visualizando ahora mismo.</li>
                    </ul>
                </div>

                <div class="row g-4">
                    <!-- COLUMNA IZQUIERDA: LISTA DE ARCHIVOS DISPONIBLES -->
                    <div class="col-md-4">
                        <div class="doc-section-subtitle">Archivos Disponibles</div>
                        <div class="doc-files-container">

                            <!-- Documento Principal -->
                            @if (!string.IsNullOrEmpty(tramite?.RutaDocumento))
                            {
                                <button type="button" class="doc-file-card @(documentoSeleccionado == "principal" ? "active" : "")" @onclick="SeleccionarDocumentoPrincipal">
                                    <div class="doc-file-info">
                                        <div class="doc-file-title">📄 Documento Principal</div>
                                        <small class="doc-file-desc">Solicitud inicial</small>
                                    </div>
                                    @if (documentoSeleccionado == "principal")
                                    {
                                        <span class="doc-badge-estado">Activo</span>
                                    }
                                </button>
                            }

                            <!-- Anexos Registrados -->
                            @{
                                int indexReg = 1;
                            }
                            @foreach (var anexo in listaAnexosRegistrados)
                            {
                                var currentAnexo = anexo;
                                var idAnexoStr = $"anexo_{currentAnexo.iCodDoc}";
                                <button type="button" class="doc-file-card @(documentoSeleccionado == idAnexoStr ? "active" : "")" @onclick="() => SeleccionarAnexo(currentAnexo)">
                                    <div class="doc-file-info">
                                        <div class="doc-file-title">📎 Anexo @indexReg</div>
                                        <small class="doc-file-desc">Documento adjunto</small>
                                    </div>
                                    @if (documentoSeleccionado == idAnexoStr)
                                    {
                                        <span class="doc-badge-estado">Activo</span>
                                    }
                                </button>
                                indexReg++;
                            }

                            @if (string.IsNullOrEmpty(tramite?.RutaDocumento) && !listaAnexosRegistrados.Any())
                            {
                                <div class="p-4 text-center text-muted bg-white" style="font-size: 0.9rem;">
                                    No hay documentos disponibles.
                                </div>
                            }
                        </div>
                    </div>

                    <!-- COLUMNA DERECHA: VISOR UNIFICADO -->
                    <div class="col-md-8">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div class="fw-bold text-secondary" style="font-size: 0.95rem;">
                                Visualizando: <span class="text-success fw-bold">@nombreDocumentoActivo</span>
                            </div>
                            @if (!string.IsNullOrEmpty(urlVisorActual) && !archivoNoDisponible)
                            {
                                <a href="@urlVisorActual" target="_blank" class="doc-btn-fullscreen text-decoration-none d-inline-flex align-items-center gap-1">
                                    🔍 Pantalla Completa
                                </a>
                            }
                        </div>

                        <div class="doc-pdf-preview-wrapper">
                            @if (cargandoPdf)
                            {
                                <div class="d-flex flex-column align-items-center justify-content-center h-100 text-center p-5 bg-white">
                                    <div class="spinner-border text-success mb-2" role="status"></div>
                                    <span class="text-muted" style="font-size: 0.9rem;">Cargando documento adjunto...</span>
                                    <small class="text-muted" style="font-size: 0.75rem;">Por favor espere unos segundos mientras se procesa el archivo.</small>
                                </div>
                            }
                            else if (archivoNoDisponible || string.IsNullOrEmpty(urlVisorActual))
                            {
                                <div class="d-flex flex-column align-items-center justify-content-center h-100 text-center p-5 bg-white">
                                    <div class="rounded-circle bg-warning bg-opacity-15 text-warning d-flex align-items-center justify-content-center mb-3 shadow-sm" style="width: 70px; height: 70px; font-size: 2rem; border: 2px solid rgba(245, 158, 11, 0.2);">
                                        ⚠️
                                    </div>
                                    <h5 class="fw-bold text-dark mb-2" style="font-size: 1.15rem;">Documento no encontrado</h5>
                                    <p class="text-muted mb-3" style="max-width: 380px; font-size: 0.88rem; line-height: 1.5;">
                                        El archivo físico no se encuentra disponible en el servidor. Comuníquese con soporte.
                                    </p>
                                    <div class="p-2 px-3 rounded-3 bg-light border shadow-sm text-secondary" style="font-size: 0.8rem;">
                                        📞 Soporte Técnico: <strong class="text-dark">(01) 2058030 Anexo 0105</strong>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <iframe src="@urlVisorActual" style="width: 100%; height: 100%; border: none;"></iframe>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Botón de Retorno Global -->
            <div class="ux-actions-fixed">
                <button class="ux-button-secondary" @onclick="Regresar">Regresar</button>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public int idAsunto { get; set; }
    private AsuntoEdicionDto? tramite;
    private List<TipoDocumento> listaTiposDocumento = new(); 
    private List<AnexoDto> listaAnexosRegistrados = new();

    // Variables de control para el visor unificado de dos columnas
    private string documentoSeleccionado = "principal";
    private string nombreDocumentoActivo = "Documento Principal";
    private string? urlVisorActual;
    private bool cargandoPdf = false;
    private bool archivoNoDisponible = false;
    private string error = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            tramite = await Http.GetFromJsonAsync<AsuntoEdicionDto>($"api/documentos/DatosRegistrados/{idAsunto}");
            listaTiposDocumento = await Http.GetFromJsonAsync<List<TipoDocumento>>("api/documentos/tipos-documento");

            await CargarAnexos();

            // Por defecto seleccionamos y cargamos el documento principal si existe
            if (tramite != null && !string.IsNullOrEmpty(tramite.RutaDocumento))
            {
                await SeleccionarDocumentoPrincipal();
            }
            else if (listaAnexosRegistrados.Any())
            {
                // Si no hay principal pero hay anexos, seleccionamos el primero por defecto
                await SeleccionarAnexo(listaAnexosRegistrados.First());
            }
        }
        catch (Exception ex)
        {
            error = "No se pudieron cargar los datos iniciales del trámite.";
            Console.WriteLine($"[Error Init]: {ex.Message}");
        }
    }

    private async Task CargarAnexos()
    {
        listaAnexosRegistrados = await Http.GetFromJsonAsync<List<AnexoDto>>($"api/documentos/listar-anexos/{idAsunto}") ?? new();
    }

    // Método para seleccionar y cargar el Documento Principal
    private async Task SeleccionarDocumentoPrincipal()
    {
        documentoSeleccionado = "principal";
        nombreDocumentoActivo = "Documento Principal";

        if (tramite == null) return;

        var baseUrl = Configuration["ApiSettings:BaseUrl"] ?? "https://localhost:7100/";
        if (!baseUrl.EndsWith("/")) baseUrl += "/";
        var urlEndpoint = $"{baseUrl}api/documentos/ver-archivo/{tramite.iCodAsunto}";

        await CargarPdfEnVisor(urlEndpoint);
    }

    // Método para seleccionar y cargar un Anexo específico
    private async Task SeleccionarAnexo(AnexoDto anexo)
    {
        documentoSeleccionado = $"anexo_{anexo.iCodDoc}";

        // Calcular el número del anexo según su posición en la lista para mostrarlo ordenado
        int index = listaAnexosRegistrados.FindIndex(a => a.iCodDoc == anexo.iCodDoc) + 1;
        nombreDocumentoActivo = $"Anexo {index}";

        var baseUrl = Configuration["ApiSettings:BaseUrl"] ?? "https://localhost:7100/";
        if (!baseUrl.EndsWith("/")) baseUrl += "/";
        var urlEndpoint = $"{baseUrl}api/documentos/ver-archivo-anexo/{anexo.iCodDoc}";

        await CargarPdfEnVisor(urlEndpoint);
    }

    // Lógica general reutilizable para descargar bytes, validar PDF y generar Blob URL para el iframe
    private async Task CargarPdfEnVisor(string url)
    {
        try
        {
            cargandoPdf = true;
            archivoNoDisponible = false;
            StateHasChanged();

            // Limpiar blob anterior si existe para evitar fugas de memoria
            if (!string.IsNullOrWhiteSpace(urlVisorActual) && urlVisorActual.StartsWith("blob:", StringComparison.OrdinalIgnoreCase))
            {
                try
                {
                    await JSRuntime.InvokeVoidAsync("console.log", $"[MPV VERTRAMITE] Liberando Blob anterior: {urlVisorActual}");
                    await JSRuntime.InvokeVoidAsync("mpvPdf.revoke", urlVisorActual);
                }
                catch (Exception exRevoke)
                {
                    await JSRuntime.InvokeVoidAsync("console.warn", $"[MPV VERTRAMITE] No se pudo liberar Blob: {exRevoke.Message}");
                }
                urlVisorActual = null;
            }

            await JSRuntime.InvokeVoidAsync("console.log", $"[MPV VERTRAMITE] GET {url}");
            using var response = await Http.GetAsync(url, HttpCompletionOption.ResponseHeadersRead);

            if (!response.IsSuccessStatusCode)
            {
                var detalle = await response.Content.ReadAsStringAsync();
                await JSRuntime.InvokeVoidAsync("console.error", $"[MPV VERTRAMITE] API devolvió error: {detalle}");
                archivoNoDisponible = true;
                urlVisorActual = null;
                return;
            }

            var bytes = await response.Content.ReadAsByteArrayAsync();
            await JSRuntime.InvokeVoidAsync("console.log", $"[MPV VERTRAMITE] Bytes recibidos: {bytes.Length}");

            if (bytes.Length == 0)
            {
                archivoNoDisponible = true;
                urlVisorActual = null;
                return;
            }

            // Validación de la firma de cabecera PDF (%PDF-)
            bool firmaPdf = bytes.Length >= 5 &&
                            bytes[0] == (byte)'%' &&
                            bytes[1] == (byte)'P' &&
                            bytes[2] == (byte)'D' &&
                            bytes[3] == (byte)'F' &&
                            bytes[4] == (byte)'-';

            await JSRuntime.InvokeVoidAsync("console.log", $"[MPV VERTRAMITE] Firma PDF válida: {firmaPdf}");

            if (!firmaPdf)
            {
                archivoNoDisponible = true;
                urlVisorActual = null;
                return;
            }

            using var memoryStream = new MemoryStream(bytes, writable: false);
            using var streamRef = new DotNetStreamReference(memoryStream);

            urlVisorActual = await JSRuntime.InvokeAsync<string>("mpvPdf.create", streamRef);
            archivoNoDisponible = false;
            await JSRuntime.InvokeVoidAsync("console.log", $"[MPV VERTRAMITE] Blob creado correctamente: {urlVisorActual}");
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", $"[MPV VERTRAMITE] ERROR CargarPdfEnVisor: {ex}");
            archivoNoDisponible = true;
            urlVisorActual = null;
        }
        finally
        {
            cargandoPdf = false;
            StateHasChanged();
        }
    }

    private void Regresar()
    {
        Ir("/Tramitar");
    }
}