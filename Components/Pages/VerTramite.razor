@layout MainLayout
@page "/VerTramite/{idAsunto:int}"
@inject HttpClient Http
@inherits PageBase
@inject IJSRuntime JSRuntime
@inject IConfiguration Configuration

<PageTitle>Mesa de Partes Virtual - Detalle del Trámite</PageTitle>

<div class="ux-bg-t">
    <div class="ux-container-t">
        <div class="ux-hero-t">
            <div class="ux-badge-top-t" style="background-color: #0284c7; color: white;">Vista Previa / Detalle</div>
            <h1>CÓDIGO DE TRÁMITE: @(tramite?.CodigoTramite ?? idAsunto.ToString())</h1>
            <p class="ux-description-t">Consulta la información registrada y el estado actual de tu expediente.</p>
        </div>

        @if (tramite != null)
        {
            <!-- Información del Expediente (Solo Lectura) -->
            <div class="ux-card-form">
                <h2>Información del Expediente</h2>
                <div class="form-grid-t">
                    <div class="form-group-t">
                        <label>Tipo de Trámite</label>
                        <select @bind="tramite.TipoTramite" class="ux-select" disabled>
                            <option value="0">Seleccione...</option>
                            <option value="1">Persona Jurídica</option>
                            <option value="2">Persona Natural</option>
                        </select>
                    </div>

                    @if (tramite.TipoTramite == 1)
                    {
                        <div class="form-group-t animate-fade-in span-two">
                            <label>RUC</label>
                            <div class="ux-input-group">
                                <input @bind="tramite.RucTramite" disabled />
                            </div>
                        </div>
                    }

                    <div class="form-group-t">
                        <label>Correo de Seguimiento</label>
                        <input type="email" class="form-control-t" @bind="tramite.CorreoTramite" disabled />
                    </div>
                    <div class="form-group-t">
                        <label>Dependencia</label>
                        <input type="text" class="form-control-t" value="@tramite.NombreDependencia" disabled />
                    </div>
                    <div class="form-group-t">
                        <label>Estado Actual</label>
                        <div class="estado-display">@tramite.EstadoTramite</div>
                    </div>
                    <div class="form-group-t">
                        <label>Fecha de Creación</label>
                        <div class="estado-display">@tramite.Fecha</div>
                    </div>
                    <div class="form-group-t">
                        <label>CUT</label>
                        <div class="estado-display @(string.IsNullOrEmpty(tramite.CUTTramite) ? "text-muted fst-italic" : "")">
                            @(string.IsNullOrEmpty(tramite.CUTTramite) ? "NO CONTIENE CUT ACTUALMENTE" : tramite.CUTTramite)
                        </div>
                    </div>
                </div>
            </div>

            <!-- Información del Documento (Solo Lectura) -->
            <div class="ux-card-form">
                <h2>Información del Documento</h2>
                <div class="form-grid-t">
                    <div class="form-group-t span-two">
                        <label>Asunto / Sumilla</label>
                        <textarea class="form-control-t" @bind="tramite.AsuntoTramite" disabled style="resize: vertical; min-height: 80px;"></textarea>
                    </div>
                    <div class="form-group-t">
                        <label>Tipo de Documento</label>
                        <select @bind="tramite.iCodTipoDoc" disabled>
                            <option value="0">--SELECCIONAR--</option>
                            @foreach (var doc in listaTiposDocumento)
                            {
                                <option value="@doc.iCodTipoDoc">@doc.vNombreTipoDoc</option>
                            }
                        </select>
                    </div>
                    <div class="form-group-t">
                        <label>Nro Documento</label>
                        <input @bind="tramite.NroDocumento" disabled />
                    </div>
                    <div class="form-group-t">
                        <label>Folio</label>
                        <input @bind="tramite.FoliosDocumento" disabled />
                    </div>
                    <div class="form-group-t">
                        <label>Fecha del Documento</label>
                        <input type="date" @bind="tramite.FechaDocumento" disabled />
                    </div>
                    <div class="form-group-t span-two">
                        <label>Referencia</label>
                        <input @bind="tramite.RefDocumento" disabled />
                    </div>
                </div>
            </div>

            <!-- Documento Adjunto (Solo Visualización) -->
            <div class="ux-card-form">
                <h2>Documento Adjunto</h2>
                <p class="text-muted mb-3" style="font-size: 0.9rem;">Visualice el documento principal registrado en el sistema</p>

                <div class="form-grid-t">
                    @if (!string.IsNullOrEmpty(tramite?.RutaDocumento))
                    {
                        <div class="form-group-t span-two">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div class="ux-file-info fw-semibold text-secondary d-flex align-items-center gap-2" style="margin-bottom: 0;">
                                    📂 <span>Documento registrado en el sistema</span>
                                </div>
                                <a href="@GetApiUrl(tramite.iCodAsunto)" target="_blank" class="ux-button-small text-decoration-none d-inline-flex align-items-center gap-1">
                                    🔍 Ver en Pantalla Completa
                                </a>
                            </div>

                            <div class="ux-pdf-preview rounded-4 overflow-hidden shadow-sm border bg-light" style="width: 100%; height: 500px; border: 1px solid #ccc;">
                                <object data="@GetApiUrl(tramite.iCodAsunto)" type="application/pdf" width="100%" height="100%">
                                    <div class="d-flex flex-column align-items-center justify-content-center h-100 text-center p-5 my-auto bg-white">
                                        <div class="rounded-circle bg-warning bg-opacity-15 text-warning d-flex align-items-center justify-content-center mb-3 shadow-sm" style="width: 80px; height: 80px; font-size: 2.2rem; border: 2px solid rgba(245, 158, 11, 0.2);">
                                            ⚠️
                                        </div>
                                        <h5 class="fw-bold text-dark mb-2" style="font-size: 1.25rem;">Documento no encontrado</h5>
                                        <p class="text-muted mb-4" style="max-width: 420px; font-size: 0.92rem; line-height: 1.5;">
                                            El archivo físico no se encuentra disponible en el servidor.<br />
                                            Por favor, comuníquese con el <strong>área de soporte</strong> para mayor detalle.
                                        </p>
                                        <div class="d-inline-flex align-items-center gap-2 px-4 py-2 rounded-3 bg-light border shadow-sm" style="font-size: 0.9rem; color: #1e293b;">
                                            <span style="font-size: 1.1rem;">📞</span>
                                            <span>Soporte Técnico:</span>
                                            <strong class="text-dark">(01) 2058030 Anexo 0105</strong>
                                        </div>
                                    </div>
                                </object>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Anexos del Trámite (Solo Visualización) -->
            <div class="ux-card-form">
                <h2>Anexos del Trámite</h2>

                <h3 style="font-size: 1.1rem; margin-bottom: 10px; color: #333;">Documentos Registrados</h3>
                <div class="ux-table-wrapper" style="margin-bottom: 25px; border-radius: 8px; overflow: hidden; border: 1px solid #e2e8f0;">
                    <table class="ux-table" style="width: 100%; border-collapse: collapse;">
                        <thead>
                            <tr style="background-color: #f8fafc; border-bottom: 2px solid #e2e8f0; text-align: left;">
                                <th style="padding: 12px 16px; font-weight: 600; color: #475569;">Nombre</th>
                                <th style="padding: 12px 16px; font-weight: 600; color: #475569;">Tipo</th>
                                <th style="padding: 12px 16px; font-weight: 600; color: #475569; text-align: right;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (listaAnexosRegistrados.Any())
                            {
                                int indexReg = 1;
                                @foreach (var anexo in listaAnexosRegistrados)
                                {
                                    var nombreVisual = $"Anexo {indexReg++}";
                                    <tr style="border-bottom: 1px solid #f1f5f9;">
                                        <td style="padding: 12px 16px; font-weight: 500; color: #1e293b;">@nombreVisual</td>
                                        <td style="padding: 12px 16px;">
                                            <span style="background-color: #ecfdf5; color: #059669; padding: 4px 8px; border-radius: 6px; font-size: 0.85rem;">PDF</span>
                                        </td>
                                        <td style="padding: 12px 16px; text-align: right;">
                                            <button class="ux-button-small" @onclick="() => VerDocumento(anexo)">
                                                🔍 Ver
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" class="ux-empty" style="padding: 24px; text-align: center; color: #64748b; font-style: italic;">No hay anexos registrados.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- MODAL VISOR DE PDF -->
                @if (!string.IsNullOrEmpty(previewUrl))
                {
                    <div style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(15, 23, 42, 0.75); display: flex; align-items: center; justify-content: center; z-index: 9999; backdrop-filter: blur(8px);">
                        <div style="background: white; width: 90%; max-width: 900px; height: 85vh; border-radius: 16px; display: flex; flex-direction: column; overflow: hidden;">
                            <div style="padding: 16px 24px; background: #ffffff; border-bottom: 1px solid #e2e8f0; display: flex; justify-content: space-between; align-items: center;">
                                <h4 style="margin: 0; font-size: 1.1rem; color: #1e293b; font-weight: 600;">👁️ Vista Previa del Documento</h4>
                                <button type="button" @onclick="CerrarPreview" style="background: #f1f5f9; border: none; width: 32px; height: 32px; border-radius: 50%; font-weight: bold; cursor: pointer;">✕</button>
                            </div>
                            <div style="flex: 1; background: #f8fafc; position: relative; display: flex; align-items: center; justify-content: center;">
                                @if (archivoNoDisponible)
                                {
                                    <div class="d-flex flex-column align-items-center justify-content-center h-100 text-center p-5 bg-white w-100">
                                        <div class="rounded-circle bg-warning bg-opacity-15 text-warning d-flex align-items-center justify-content-center mb-3 shadow-sm" style="width: 80px; height: 80px; font-size: 2.2rem; border: 2px solid rgba(245, 158, 11, 0.2);">
                                            ⚠️
                                        </div>
                                        <h5 class="fw-bold text-dark mb-2" style="font-size: 1.25rem;">Documento no encontrado</h5>
                                        <p class="text-muted mb-4" style="max-width: 420px; font-size: 0.92rem; line-height: 1.5;">
                                            El archivo físico no se encuentra disponible en el servidor.<br />
                                            Por favor, comuníquese con el <strong>área de soporte</strong> para mayor detalle.
                                        </p>
                                        <div class="d-inline-flex align-items-center gap-2 px-4 py-2 rounded-3 bg-light border shadow-sm" style="font-size: 0.9rem; color: #1e293b;">
                                            <span style="font-size: 1.1rem;">📞</span>
                                            <span>Soporte Técnico:</span>
                                            <strong class="text-dark">(01) 2058030 Anexo 0105</strong>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <iframe src="@previewUrl" style="width: 100%; height: 100%; border: none;"></iframe>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Botón de Retorno Global -->
            <div class="ux-actions-fixed">
                <button class="ux-button-secondary" @onclick="Regresar">Regresar</button>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public int idAsunto { get; set; }
    private AsuntoEdicionDto? tramite;
    private List<TipoDocumento> listaTiposDocumento = new();
    private List<AnexoDto> listaAnexosRegistrados = new();
    private string? previewUrl;
    private bool archivoNoDisponible = false;

    protected override async Task OnInitializedAsync()
    {
        tramite = await Http.GetFromJsonAsync<AsuntoEdicionDto>($"api/documentos/DatosRegistrados/{idAsunto}");
        listaTiposDocumento = await Http.GetFromJsonAsync<List<TipoDocumento>>("api/documentos/tipos-documento");
        await CargarAnexos();
    }

    private async Task CargarAnexos()
    {
        listaAnexosRegistrados = await Http.GetFromJsonAsync<List<AnexoDto>>($"api/documentos/listar-anexos/{idAsunto}") ?? new();
    }

    private string GetApiUrl(int id)
    {
        var baseUrl = Configuration["ApiSettings:BaseUrl"] ?? "https://localhost:7100/";
        if (!baseUrl.EndsWith("/")) baseUrl += "/";
        return $"{baseUrl}api/documentos/ver-archivo/{id}";
    }

    private async Task VerDocumento(AnexoDto anexo)
    {
        var baseUrl = Configuration["ApiSettings:BaseUrl"] ?? "https://localhost:7100/";
        if (!baseUrl.EndsWith("/")) baseUrl += "/";
        var url = $"{baseUrl}api/documentos/ver-archivo-anexo/{anexo.iCodDoc}";

        try
        {
            await JSRuntime.InvokeVoidAsync("console.log", $"[MPV VERTRAMITE] Click Ver anexo. iCodDoc={anexo.iCodDoc}");
            await JSRuntime.InvokeVoidAsync("console.log", $"[MPV VERTRAMITE] GET {url}");

            if (!string.IsNullOrWhiteSpace(previewUrl) && previewUrl.StartsWith("blob:", StringComparison.OrdinalIgnoreCase))
            {
                await JSRuntime.InvokeVoidAsync("mpvPdf.revoke", previewUrl);
                previewUrl = null;
            }

            using var response = await Http.GetAsync(url, HttpCompletionOption.ResponseHeadersRead);

            var contentType = response.Content.Headers.ContentType?.MediaType ?? "(sin Content-Type)";
            var contentLength = response.Content.Headers.ContentLength;

            await JSRuntime.InvokeVoidAsync(
                "console.log",
                $"[MPV VERTRAMITE] Respuesta HTTP {(int)response.StatusCode} {response.StatusCode} | Content-Type: {contentType} | Content-Length: {contentLength?.ToString() ?? "desconocido"}");

            if (!response.IsSuccessStatusCode)
            {
                var detalle = await response.Content.ReadAsStringAsync();
                await JSRuntime.InvokeVoidAsync("console.error", $"[MPV VERTRAMITE] API devolvió error: {detalle}");
                archivoNoDisponible = true;
                previewUrl = "ERROR_FILE_NOT_FOUND";
                return;
            }

            var bytes = await response.Content.ReadAsByteArrayAsync();
            await JSRuntime.InvokeVoidAsync("console.log", $"[MPV VERTRAMITE] Bytes recibidos: {bytes.Length}");

            if (bytes.Length == 0)
                throw new InvalidOperationException("La API respondió correctamente pero devolvió un archivo vacío.");

            bool firmaPdf = bytes.Length >= 5 &&
                            bytes[0] == (byte)'%' &&
                            bytes[1] == (byte)'P' &&
                            bytes[2] == (byte)'D' &&
                            bytes[3] == (byte)'F' &&
                            bytes[4] == (byte)'-';

            await JSRuntime.InvokeVoidAsync("console.log", $"[MPV VERTRAMITE] Firma PDF válida: {firmaPdf}");

            if (!firmaPdf)
            {
                var texto = System.Text.Encoding.UTF8.GetString(bytes, 0, Math.Min(bytes.Length, 500));
                await JSRuntime.InvokeVoidAsync("console.error", $"[MPV VERTRAMITE] La respuesta no parece PDF. Inicio de respuesta: {texto}");
                archivoNoDisponible = true;
                previewUrl = "ERROR_FILE_NOT_FOUND";
                return;
            }

            using var memoryStream = new MemoryStream(bytes, writable: false);
            using var streamRef = new DotNetStreamReference(memoryStream);

            previewUrl = await JSRuntime.InvokeAsync<string>("mpvPdf.create", streamRef);
            archivoNoDisponible = false;

            await JSRuntime.InvokeVoidAsync("console.log", $"[MPV VERTRAMITE] Blob creado correctamente: {previewUrl}");
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", $"[MPV VERTRAMITE] ERROR VerDocumento: {ex}");
            archivoNoDisponible = true;
            previewUrl = "ERROR_FILE_NOT_FOUND";
        }
    }

    private async Task CerrarPreview()
    {
        try
        {
            if (!string.IsNullOrWhiteSpace(previewUrl) && previewUrl.StartsWith("blob:", StringComparison.OrdinalIgnoreCase))
            {
                await JSRuntime.InvokeVoidAsync("console.log", $"[MPV VERTRAMITE] Liberando Blob: {previewUrl}");
                await JSRuntime.InvokeVoidAsync("mpvPdf.revoke", previewUrl);
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.warn", $"[MPV VERTRAMITE] No se pudo liberar Blob: {ex.Message}");
        }
        finally
        {
            previewUrl = string.Empty;
            archivoNoDisponible = false;
        }
    }

    private void Regresar()
    {
        Ir("/Tramitar");
    }
}