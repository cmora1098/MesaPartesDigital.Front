@page "/consulta-expediente"
@rendermode InteractiveServer
@inject HttpClient Http
@using MesaPartesDigital.Models

<div class="ux-bg">
    <div class="ux-container-centered">
        <div class="ux-card-form">

            <div class="ux-header-consulta">
                <p class="ux-title-institucional">CONSULTA DE TRÁMITE WEB</p>
            </div>

            <div class="ux-instruction-box">
                <p class="ux-instruction-title">ESTIMADO USUARIO, PARA REALIZAR SU CONSULTA DEBERÁ SEGUIR LOS SIGUIENTES PASOS:</p>
                <ul class="ux-instruction-list">
                    <li>
                        <strong>PASO 01:</strong> Ingresar el Nro. de Trámite (CUT) y seleccionar el año o periodo.
                    </li>
                    <li>
                        <strong>PASO 02:</strong> Hacer click en el botón Buscar y el sistema le mostrará la información solicitada.
                    </li>
                </ul>
            </div>

            <div class="ux-grid-form-single">
                <div class="ux-field">
                    <label>Nro. de trámite (CUT) *</label>
                    <input type="text" placeholder="Ej: 2049" @bind="cutBusqueda" />
                </div>

                <div class="ux-field">
                    <label>Periodo / Año *</label>
                    <select @bind="periodoBusqueda">
                        @foreach (var anio in listaAnios)
                        {
                            <option value="@anio">@anio</option>
                        }
                    </select>
                </div>

                <div class="ux-actions-block">
                    <button type="button" class="ux-button-submit" @onclick="BuscarTramite" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span>Buscando...</span>
                        }
                        else
                        {
                            <span>Buscar Trámite</span>
                        }
                    </button>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger mt-3" role="alert">
                    @errorMessage
                </div>
            }

        </div>

        @if (mostrarResultado && listaTramites != null && listaTramites.Any())
        {
            <div class="ux-card-form ux-result-card animate-fade-in mt-4">

                <!-- Encabezado general de la consulta -->
                <div class="ux-result-header-general">
                    <div>
                        <h2>Resultado de la Consulta</h2>
                        <span class="ux-subtitle-total">Se encontraron <strong>@listaTramites.Count</strong> documento(s) asociado(s) al CUT: <span class="ux-highlight">@cutBusqueda</span></span>
                    </div>
                    <span class="ux-badge-status status-success">CONSULTA EXITOSA</span>
                </div>

                <!-- Contenedor de la lista de documentos en formato compacto -->
                <div class="ux-documents-container">
                    @foreach (var (tramite, index) in listaTramites.Select((t, i) => (t, i)))
                    {
                        <div class="ux-document-item-box">
                            <div class="ux-doc-item-header">
                                <span class="ux-doc-number">Documento N° @(index + 1)</span>
                                <span class="ux-badge-status @(tramite.Estado == "ATENDIDO" ? "status-success" : "status-process")">
                                    @tramite.Estado
                                </span>
                            </div>

                            <div class="ux-result-grid">
                                <div class="ux-result-item">
                                    <span class="ux-result-label">Sede</span>
                                    <span class="ux-result-value">@tramite.Sede</span>
                                </div>

                                <div class="ux-result-item">
                                    <span class="ux-result-label">Ventanilla</span>
                                    <span class="ux-result-value">@tramite.Ventanilla</span>
                                </div>

                                <div class="ux-result-item">
                                    <span class="ux-result-label">Fecha Ingreso</span>
                                    <span class="ux-result-value">@tramite.Fec_Ingreso</span>
                                </div>

                                <div class="ux-result-item full-width">
                                    <span class="ux-result-label">Nro. Doc.</span>
                                    <span class="ux-result-value ux-code-text">@tramite.Nro_Doc</span>
                                </div>

                                <div class="ux-result-item full-width">
                                    <span class="ux-result-label">Remitente</span>
                                    <span class="ux-result-value">@(!string.IsNullOrEmpty(tramite.Rem_Emp) ? $"{tramite.Rem_Emp} - {tramite.Rem_Per}" : tramite.Rem_Per)</span>
                                </div>

                                <div class="ux-result-item full-width">
                                    <span class="ux-result-label">Asunto</span>
                                    <span class="ux-result-value ux-text-justify">@tramite.Asunto</span>
                                </div>
                            </div>

                            @* <div class="ux-current-location-box">
                                <span class="ux-location-label">Atención del Trámite:</span>

                                @if (string.IsNullOrEmpty(tramite.Ruta_Atencion))
                                {
                                    <a class="ux-location-value ux-alert-link" @onclick="() => MostrarAvisoVentanilla(tramite.Ventanilla)">
                                        Aún no hay un documento de atención, para mayor información hacer clic en el mensaje y comunicarse con una de las ventanillas.
                                    </a>
                                }
                                else
                                {
                                    <span class="ux-location-value">@tramite.Txt_Tiene</span>
                                    <a href="@tramite.Ruta_Atencion" target="_blank" class="ux-link-atencion">
                                        Ver enlace de atención &rarr;
                                    </a>
                                }
                            </div> *@
                        </div>
                    }
                </div>

                <!-- Botón único para limpiar o hacer nueva consulta -->
                <div class="ux-result-footer">
                    <button type="button" class="ux-button-back" @onclick="LimpiarBusqueda">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                            <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8z" />
                        </svg>
                        Realizar Nueva Consulta
                    </button>
                </div>

            </div>
        }
    </div>
</div>

@code {
    private string cutBusqueda = "";
    private string periodoBusqueda = "";
    private bool mostrarResultado = false;
    private bool isLoading = false;
    private string errorMessage = "";

    private List<string> listaAnios = new();
    private List<TramiteConsultaDto> listaTramites = new();

    protected override void OnInitialized()
    {
        CargarAniosAutomaticos();
    }
    private void MostrarAvisoVentanilla(string? ventanilla)
    {
        // Puedes disparar un modal, un console.log o un mensaje flotante informando sobre la ventanilla
        Console.WriteLine($"El usuario requiere comunicarse con la ventanilla: {ventanilla}");
    }

    private void CargarAniosAutomaticos()
    {
        int anioInicio = 2018;
        int anioActual = DateTime.Now.Year;

        listaAnios.Clear();

        for (int i = anioActual; i >= anioInicio; i--)
        {
            listaAnios.Add(i.ToString());
        }

        periodoBusqueda = anioActual.ToString();
    }

    private async Task BuscarTramite()
    {
        errorMessage = "";

        if (string.IsNullOrWhiteSpace(cutBusqueda))
        {
            errorMessage = "Por favor, ingrese el número de trámite (CUT).";
            return;
        }

        isLoading = true;

        try
        {
            int nroTramiteInt = int.TryParse(cutBusqueda.Trim(), out var parsed) ? parsed : 0;
            int periodoInt = int.Parse(periodoBusqueda);

            var resultado = await Http.GetFromJsonAsync<List<TramiteConsultaDto>>($"api/tramites/consultar-cut?nroTramite={nroTramiteInt}&periodo={periodoInt}");

            if (resultado != null && resultado.Any())
            {
                listaTramites = resultado;
                mostrarResultado = true;
            }
            else
            {
                errorMessage = "No se encontraron registros para los datos ingresados.";
                mostrarResultado = false;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Ocurrió un error al consultar el servicio: {ex.Message}";
            mostrarResultado = false;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void LimpiarBusqueda()
    {
        mostrarResultado = false;
        cutBusqueda = "";
        listaTramites.Clear();
        errorMessage = "";
    }
}