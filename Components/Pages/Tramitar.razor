@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage

@layout MainLayout
@page "/Tramitar"
@inject IJSRuntime JS
@inject Services.SessionService SessionService
@inherits PageBase
@inject ProtectedSessionStorage SessionStorage
@inject HttpClient Http

@if (cargando)
{
    <p>Cargando...</p>
}
else if (SessionService.UserSession == null)
{
    <p>No has iniciado sesión.</p>
}
else
{
    <PageTitle>Mesa de Partes Virtual - Menú de Trámite</PageTitle>

    <main class="dash-content">
        @if (pasoActual == "historial")
        {
            <section class="welcome-section">
                <h2>Bienvenido, @SessionService.UserSession.VNombreCompleto</h2>
                <p>Gestione sus trámites de manera rápida y segura.</p>
            </section>

            <section class="cards-grid" aria-label="Acciones principales">
                <div class="action-card card-primary">
                    <div class="card-body">
                        <span class="card-icon">📄</span>
                        <h3>Nuevo Trámite</h3>
                        <p>Registre e ingrese una nueva solicitud o expediente en línea.</p>
                    </div>
                    <button class="btn-card" @onclick='() => CambiarPaso("selector")'>Iniciar Registro</button>
                </div>
            </section>

            <section class="tramites-panel">
                <div class="tramites-header">
                    <h3>Historial de Trámites</h3>
                    <span class="badge-count">@tramitesFiltrados.Count registrados</span>
                </div>

                <!-- PANEL DE GUÍA Y LEYENDAS UNIFICADO -->
                <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 16px; margin-bottom: 20px; font-size: 13px; color: #475569;">

                    <!-- Fila 1: Acciones -->
                    <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin-bottom: 12px; padding-bottom: 12px; border-bottom: 1px solid #e2e8f0;">
                        <span style="font-weight: 600; color: #1e293b; min-width: 140px;"><i class="bi bi-tools me-1"></i> Acciones:</span>

                        <div style="display: flex; align-items: center; gap: 6px;">
                            <button class="btn btn-outline-success btn-sm py-0 px-2" style="font-size: 11px; pointer-events: none;"><i class="bi bi-paperclip"></i></button>
                            <span style="font-size: 12px;">Ver adjuntos</span>
                        </div>

                        <div style="display: flex; align-items: center; gap: 6px;">
                            <button class="btn btn-outline-primary btn-sm py-0 px-2" style="font-size: 11px; pointer-events: none;"><i class="bi bi-eye"></i></button>
                            <span style="font-size: 12px;">Detalle</span>
                        </div>

                        <div style="display: flex; align-items: center; gap: 6px;">
                            <button class="btn btn-sm py-0 px-2 fw-semibold" style="background-color: #ffc107; border-color: #ffc107; color: #212529; font-size: 11px; pointer-events: none;"><i class="bi bi-pencil-square"></i></button>
                            <span style="font-size: 12px;">Editar (Solo Observados)</span>
                        </div>
                    </div>

                    <!-- Fila 2: Estados -->
                    <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 12px;">
                        <span style="font-weight: 600; color: #1e293b; min-width: 140px;"><i class="bi bi-shield-check me-1"></i> Estados:</span>

                        <div style="display: flex; align-items: center; gap: 6px;">
                            <span class="estado enviado" style="padding: 2px 8px; border-radius: 4px; font-size: 0.7rem; font-weight: 700; text-transform: uppercase; background-color: #fef3c7; color: #d97706;">Enviado</span>
                        </div>
                        <div style="display: flex; align-items: center; gap: 6px;">
                            <span class="estado proceso" style="padding: 2px 8px; border-radius: 4px; font-size: 0.7rem; font-weight: 700; text-transform: uppercase; background-color: #e0f2fe; color: #0284c7;">Pendiente</span>
                        </div>
                        <div style="display: flex; align-items: center; gap: 6px;">
                            <span class="estado finalizado" style="padding: 2px 8px; border-radius: 4px; font-size: 0.7rem; font-weight: 700; text-transform: uppercase; background-color: #dcfce7; color: #16a34a;">Finalizado</span>
                        </div>
                        <div style="display: flex; align-items: center; gap: 6px;">
                            <span class="estado archivado" style="padding: 2px 8px; border-radius: 4px; font-size: 0.7rem; font-weight: 700; text-transform: uppercase; background-color: #f1f5f9; color: #475569;">Archivado</span>
                        </div>
                        <div style="display: flex; align-items: center; gap: 6px;">
                            <span class="estado observado" style="padding: 2px 8px; border-radius: 4px; font-size: 0.7rem; font-weight: 700; text-transform: uppercase; background-color: #fee2e2; color: #dc2626;">Observado</span>
                        </div>
                    </div>
                </div>

                <div class="filtros-container">
                    <div class="filtro-item">
                        <input type="text" @bind="filtroCodigo" placeholder="Buscar por código..." />
                    </div>
                    <div class="filtro-item">
                        <select @bind="filtroEstado">
                            <option value="todos">Todos los estados</option>
                            <option value="enviado">Enviado</option>
                            <option value="proceso">En proceso</option>
                            <option value="finalizado">Finalizado</option>
                            <option value="observado">Observado</option>
                        </select>
                    </div>
                    <button class="btn-buscar" @onclick="AplicarFiltros">Filtrar Historial</button>
                </div>

                <div class="table-responsive">
                    <table class="custom-table">
                        <thead>
                            <tr>
                                <th>Estado</th>
                                <th>Código</th>
                                <th>Asunto</th>
                                <th>Fecha</th>
                                <th>Fecha Subsanación</th>
                                <th>Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in GetTramitesPaginados())
                            {
                                <tr>
                                    <td><span class="estado @item.Estado.ToLower()">@item.Estado</span></td>
                                    <td class="txt-bold">@item.Codigo</td>
                                    <td>@item.Asunto</td>
                                    <td class="txt-date">@item.Fecha</td>
                                    <td class="txt-date">@item.FechaSubsanacion</td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <button class="btn btn-outline-success btn-sm shadow-sm" @onclick="() => DocumentosAdjuntos(item.iCodAsunto)" title="Ver documentos adjuntos">
                                                <i class="bi bi-paperclip"></i>
                                            </button>
                                            <button class="btn btn-outline-primary btn-sm shadow-sm" @onclick='() => Ir($"/VerTramite/{item.iCodAsunto}")' title="Ver detalle o vista previa">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                            @if (item.Estado.Equals("Observado", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <button class="btn btn-sm shadow-sm fw-semibold" style="background-color: #ffc107; border-color: #ffc107; color: #212529;" @onclick="() => EditarTramite(item.iCodAsunto)" title="Editar trámite observado">
                                                    <i class="bi bi-pencil-square"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="pagination-container" style="display: flex; justify-content: center; align-items: center; gap: 15px; margin-top: 20px;">
                    <button class="btn btn-sm btn-secondary" disabled="@(paginaActual == 1)" @onclick="() => CambiarPagina(paginaActual - 1)">Anterior</button>
                    <span>Página <strong>@paginaActual</strong> de <strong>@(totalPaginas == 0 ? 1 : totalPaginas)</strong></span>
                    <button class="btn btn-sm btn-secondary" disabled="@(paginaActual >= totalPaginas)" @onclick="() => CambiarPagina(paginaActual + 1)">Siguiente</button>
                </div>
            </section>

        }
        else if (pasoActual == "selector")
        {
            <div class="ux-bg-t">
                <div class="ux-container-t">
                    <div class="ux-hero-t">
                        <div class="ux-badge-top-t">Mesa de Partes Virtual</div>
                        <p class="ux-description-t">Selecciona cómo deseas realizar tus trámites. Esto nos ayudará a personalizar tu experiencia.</p>
                    </div>

                    <div class="ux-grid-t">
                        <div class="ux-card-t @(tipoPersona == "TPersonaNatural" ? "active" : "")" @onclick="SeleccionarNatural">
                            <div class="ux-icon-circle">👤</div>
                            <h3>Persona Natural</h3>
                            <p>Ciudadanos que realizan trámites personales o individuales.</p>
                            @if (tipoPersona == "TPersonaNatural")
                            {
                                <div class="ux-selected">✔ Seleccionado</div>
                            }
                        </div>

                        <div class="ux-card-t @(tipoPersona == "TPersonaJuridica" ? "active" : "")" @onclick="SeleccionarJuridica">
                            <div class="ux-icon-circle">🏢</div>
                            <h3>Persona Jurídica</h3>
                            <p>Empresas, instituciones o entidades públicas/privadas.</p>
                            @if (tipoPersona == "TPersonaJuridica")
                            {
                                <div class="ux-selected">✔ Seleccionado</div>
                            }
                        </div>
                    </div>

                    <div class="ux-actions">
                        <button class="ux-button-secondary" @onclick='() => CambiarPaso("historial")'>← Volver</button>
                        <button class="ux-button" @onclick="Continuar" disabled="@string.IsNullOrEmpty(tipoPersona)">Continuar →</button>
                    </div>
                </div>
            </div>
        }
        else if (pasoActual == "formulario_natural" || pasoActual == "formulario_juridica")
        {
            <div class="form-wrapper">
                <button class="ux-button-secondary" @onclick='() => CambiarPaso("selector")'>← Cambiar tipo</button>

                @if (pasoActual == "formulario_natural")
                {
                    <TramitePerNatural UsuarioId="@SessionService.UserSession.ICodPer"
                                       UsuarioEmail="@SessionService.UserSession.VEmail"
                                       OnVolver='() => CambiarPaso("selector")' />
                }
                else
                {
                    <TramitePerJuridica UsuarioId="@SessionService.UserSession.ICodPer"
                                        UsuarioEmail="@SessionService.UserSession.VEmail"
                                        OnVolver='() => CambiarPaso("selector")' />
                }
            </div>
        }
    </main>

    <!-- Modal de Previsualización de Documentos -->
    @if (mostrarModalDocumentos)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.75); backdrop-filter: blur(8px); z-index: 1050;">
            <div class="modal-dialog modal-xl modal-dialog-centered">
                <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden" style="background: #ffffff; border: 1px solid rgba(226, 232, 240, 0.8) !important;">

                    <!-- Cabecera Verde Institucional -->
                    <div class="modal-header px-4 py-3.5 text-white" style="background: #198754;">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-3 bg-white bg-opacity-15 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                                <span class="fs-5">🗂️</span>
                            </div>
                            <div>
                                <h5 class="modal-title fw-bold m-0 tracking-wide">Gestión de Documentos Adjuntos</h5>
                                <small class="text-white-50 m-0">Navegación rápida de archivos asociados</small>
                            </div>
                        </div>
                        <button type="button" class="btn-close btn-close-white shadow-none" @onclick="CerrarModalDocumentos" aria-label="Cerrar"></button>
                    </div>

                    <!-- Cuerpo del Modal: Dos Caras (Menú Izquierdo / Visor Derecho) -->
                    <div class="modal-body p-4 bg-light">
                        <div class="row g-4">

                            <!-- CARA IZQUIERDA: Selector Estilo Bandeja con Leyenda Incorporada -->
                            <div class="col-lg-4">
                                <div class="bg-white p-3 rounded-4 shadow-sm border h-100 d-flex flex-column" style="border-color: #e2e8f0 !important;">
                                    <div class="px-2 pb-3 border-bottom mb-3">
                                        <h6 class="fw-bold text-dark m-0">Archivos Disponibles</h6>
                                        <small class="text-muted">Seleccione un documento para visualizarlo</small>
                                    </div>

                                    <!-- Leyenda / Indicaciones de Uso -->
                                    <div class="alert alert-success bg-success-subtle border-0 py-2 px-3 rounded-3 mb-3" style="font-size: 0.82rem;">
                                        <div class="fw-bold text-success mb-1 d-flex align-items-center gap-1">
                                            <span>💡 Guía de uso:</span>
                                        </div>
                                        <ul class="mb-0 ps-3 text-secondary">
                                            <li>Haga <strong class="text-dark">clic en cualquier tarjeta</strong> para cargar el archivo en el visor de la derecha.</li>
                                            <li>El estado <span class="badge bg-success text-white" style="font-size: 0.7rem;">Activo</span> indica el documento que está visualizando ahora mismo.</li>
                                        </ul>
                                    </div>

                                    <div class="d-flex flex-column gap-2 overflow-y-auto flex-grow-1" style="max-height: 380px;">

                                        <!-- Elemento Principal -->
                                        <div class="p-3 rounded-3 border transition-all @(tipoVisualizacion == "Principal" ? "border-success border-2 bg-success-subtle shadow-sm" : "bg-white")"
                                             @onclick="SeleccionarDocumentoPrincipal" style="cursor: pointer;">
                                            <div class="d-flex align-items-center gap-3">
                                                <div class="fs-4 text-success">📄</div>
                                                <div class="flex-grow-1 text-truncate">
                                                    <h6 class="fw-bold text-dark mb-0 fs-6">Documento Principal</h6>
                                                    <small class="text-muted" style="font-size: 0.8rem;">Solicitud inicial</small>
                                                </div>
                                                @if (tipoVisualizacion == "Principal")
                                                {
                                                    <span class="badge bg-success text-white">Activo</span>
                                                }
                                            </div>
                                        </div>

                                        <!-- Elementos de Anexos -->
                                        @if (listaAnexosModal.Any())
                                        {
                                            int indexL = 1;
                                            @foreach (var anexo in listaAnexosModal)
                                            {
                                                var nombreL = $"Anexo {indexL++}";
                                                var activoL = tipoVisualizacion == $"Anexo_{anexo.iCodDoc}";
                                                <div class="p-3 rounded-3 border transition-all @(activoL ? "border-success border-2 bg-success-subtle shadow-sm" : "bg-white")"
                                                     @onclick="() => SeleccionarAnexoModal(anexo)" style="cursor: pointer;">
                                                    <div class="d-flex align-items-center gap-3">
                                                        <div class="fs-4 text-secondary">📎</div>
                                                        <div class="flex-grow-1 text-truncate">
                                                            <h6 class="fw-bold text-dark mb-0 fs-6 text-truncate" style="max-width: 140px;" title="@anexo.Nombre">@nombreL</h6>
                                                        </div>
                                                        @if (activoL)
                                                        {
                                                            <span class="badge bg-success text-white">Activo</span>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- CARA DERECHA: Visor Amplio -->
                            <div class="col-lg-8">
                                <div class="card border shadow-sm rounded-4 bg-white h-100 d-flex flex-column" style="border-color: #e2e8f0 !important;">
                                    <div class="d-flex justify-content-between align-items-center px-4 py-3 bg-white border-bottom">
                                        <span class="text-secondary small fw-semibold">Visualizando: <span class="text-success fw-bold">@tituloDocumentoActual</span></span>
                                        @if (!string.IsNullOrEmpty(urlDocumentoActual) && !archivoNoDisponible && !estaCargandoArchivo)
                                        {
                                            <a href="@urlDocumentoActual" target="_blank" class="btn btn-sm btn-outline-success fw-semibold px-3 py-1.5 d-flex align-items-center gap-1.5 rounded-2">
                                                <span>🔍</span> Pantalla Completa
                                            </a>
                                        }
                                    </div>

                                    <div class="bg-light position-relative flex-grow-1 d-flex flex-column" style="min-height: 480px;">
                                        @if (estaCargandoArchivo)
                                        {
                                            <!-- SPINNER DE CARGA INTEGRADO EN EL VISOR -->
                                            <div class="d-flex flex-column align-items-center justify-content-center h-100 text-center p-5 my-auto flex-grow-1">
                                                <div class="spinner-border text-success mb-3" role="status" style="width: 3rem; height: 3rem;"></div>
                                                <h6 class="fw-bold text-dark">Cargando documento adjunto...</h6>
                                                <p class="text-muted small">Por favor espere unos segundos mientras se procesa el archivo.</p>
                                            </div>
                                        }
                                        else if (!string.IsNullOrEmpty(urlDocumentoActual))
                                        {
                                            @if (archivoNoDisponible)
                                            {
                                                <!-- DOCUMENTO NO ENCONTRADO -->
                                                <div class="d-flex flex-column align-items-center justify-content-center h-100 text-center p-5 my-auto flex-grow-1">
                                                    <div class="rounded-circle bg-warning bg-opacity-15 text-warning d-flex align-items-center justify-content-center mb-3 shadow-sm" style="width: 80px; height: 80px; font-size: 2.2rem; border: 2px solid rgba(245, 158, 11, 0.2);">
                                                        ⚠️
                                                    </div>
                                                    <h5 class="fw-bold text-dark mb-2" style="font-size: 1.25rem;">Documento no encontrado</h5>
                                                    <p class="text-muted mb-4" style="max-width: 400px; font-size: 0.92rem; line-height: 1.5;">
                                                        El archivo físico no se encuentra disponible en el servidor. Por favor, comuníquese con el <strong>área de soporte</strong> para mayor detalle.
                                                    </p>
                                                    <div class="p-3 rounded-3 bg-white border shadow-sm d-inline-flex align-items-center gap-2 text-secondary" style="font-size: 0.85rem; border-color: #e2e8f0 !important;">
                                                        <span>📞</span> Soporte Técnico: <strong class="text-dark">(01) 2058030 Anexo 0105</strong>
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                <iframe src="@urlDocumentoActual" style="width: 100%; height: 100%; border: none; background: #ffffff; flex-grow: 1;"></iframe>
                                            }
                                        }
                                        else
                                        {
                                            <div class="d-flex flex-column align-items-center justify-content-center h-100 text-muted p-5 text-center my-auto flex-grow-1">
                                                <div class="fs-1 mb-2 text-secondary opacity-50">📂</div>
                                                <p class="mb-0">Elige un documento de la lista izquierda para visualizarlo en este espacio.</p>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>

                    <!-- Pie del Modal -->
                    <div class="modal-footer bg-white px-4 py-3 justify-content-end border-top">
                        <button type="button" class="btn btn-secondary px-5 py-2 rounded-3 fw-bold shadow-sm" @onclick="CerrarModalDocumentos">
                            Cerrar Ventana
                        </button>
                    </div>

                </div>
            </div>
        </div>
    }

    @if (estaCargandoArchivo)
    {
        <div class="d-flex flex-column align-items-center justify-content-center h-100 text-center p-5 my-auto">
            <div class="spinner-border text-success mb-3" role="status" style="width: 3rem; height: 3rem;"></div>
            <h6 class="fw-bold text-dark">Cargando documento adjunto...</h6>
            <p class="text-muted small">Por favor espere unos segundos mientras se procesa el archivo.</p>
        </div>
    }
 }


@* @code {
    private bool cargando = true;
    private UserSession Session = new UserSession();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                if (SessionService.UserSession == null)
                {
                    var json = await JS.InvokeAsync<string>("localStorage.getItem", "user_session");
                    if (!string.IsNullOrEmpty(json))
                    {
                        SessionService.UserSession = System.Text.Json.JsonSerializer.Deserialize<LoginResultDto>(json);
                    }
                    else
                    {
                        Ir($"/login", true);
                        return;
                    }
                }

                var userId = SessionService.UserSession?.ICodPer;

                if (userId != null && todosLosTramites.Count == 0)
                {
                    try
                    {
                        var lista = await Http.GetFromJsonAsync<List<TramiteDto>>($"api/documentos/historial/{userId}");

                        if (lista != null)
                        {
                            todosLosTramites = lista;
                            tramitesFiltrados = todosLosTramites;
                        }
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"Error al obtener historial: {ex.Message}");
                    }
                }

                esAutorizado = true;
                cargando = false;
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error crítico en carga: {ex.Message}");
                Ir($"/login", true);
            }
        }
    }

    private bool esAutorizado = false;
    private string pasoActual = "historial";
    private string tipoPersona = string.Empty;
    private string filtroCodigo = "";
    private string filtroEstado = "todos";

    private void CambiarPaso(string nuevoPaso) => pasoActual = nuevoPaso;
    private void SeleccionarNatural() => tipoPersona = "TPersonaNatural";
    private void SeleccionarJuridica() => tipoPersona = "TPersonaJuridica";

    private void Continuar()
    {
        if (!string.IsNullOrWhiteSpace(tipoPersona))
            Ir($"/Tramitar/{tipoPersona}");
    }

    private int paginaActual = 1;
    private int elementosPorPagina = 5;
    private int totalPaginas => (int)Math.Ceiling((double)tramitesFiltrados.Count / elementosPorPagina);

    private List<TramiteDto> todosLosTramites = new();
    private List<TramiteDto> tramitesFiltrados = new();

    private IEnumerable<TramiteDto> GetTramitesPaginados() =>
        tramitesFiltrados.Skip((paginaActual - 1) * elementosPorPagina).Take(elementosPorPagina);

    private void CambiarPagina(int nuevaPagina)
    {
        if (nuevaPagina >= 1 && nuevaPagina <= totalPaginas)
        {
            paginaActual = nuevaPagina;
        }
    }

    private void AplicarFiltros()
    {
        tramitesFiltrados = todosLosTramites.Where(t =>
            (string.IsNullOrEmpty(filtroCodigo) || t.Codigo.Contains(filtroCodigo, StringComparison.OrdinalIgnoreCase)) &&
            (filtroEstado == "todos" || t.Estado.Equals(filtroEstado, StringComparison.OrdinalIgnoreCase))
        ).ToList();

        paginaActual = 1;
    }

    private void EditarTramite(int idAsunto)
    {
        Ir($"/EditarTramite/{idAsunto}");
    }

    private bool mostrarModalDocumentos = false;
    private int idAsuntoSeleccionado = 0;
    private string tipoVisualizacion = "";
    private string urlDocumentoActual = "";
    private string tituloDocumentoActual = "";
    private List<AnexoDto> listaAnexosModal = new();
    private string? objectUrlActual = null;
    private bool estaCargandoArchivo = false;

    private async Task DocumentosAdjuntos(int idAsunto)
    {
        try
        {
            idAsuntoSeleccionado = idAsunto;
            listaAnexosModal = await Http.GetFromJsonAsync<List<AnexoDto>>($"api/documentos/listar-anexos/{idAsunto}") ?? new();

            tituloDocumentoActual = "Documento Principal";
            tipoVisualizacion = "Principal";
            mostrarModalDocumentos = true;

            await CargarArchivoComoBlob($"api/documentos/ver-archivo/{idAsunto}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al abrir documentos adjuntos: {ex.Message}");
        }
    }

    private async Task SeleccionarDocumentoPrincipal()
    {
        tituloDocumentoActual = "Documento Principal";
        tipoVisualizacion = "Principal";
