@page "/inicio/juridica"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Components.Forms
@using MesaPartesDigital.Models

@using System.Net.Http.Json
@inject HttpClient Http
@inherits PageBase

@inject IJSRuntime JS
@inject DocumentoAdjuntoServices ArchivoPrincipalService

<PageTitle>Mesa de Partes Virtual - Solicitud de Trámite, Persona Jurídica</PageTitle>

<div class="ux-bg">

    <div class="ux-container">

        <div class="ux-header">
            <div class="ux-badge-top">Mesa de Partes Virtual</div>
            <h1>Persona Jurídica</h1>
            <p class="ux-description">
                Completa todos los campos para registrar tu documento.
            </p>
        </div>

        <div class="alert alert-warning border-warning shadow-sm mb-4" role="alert" style="background-color: #fff3cd; border-left: 5px solid #ffc107; padding: 15px; border-radius: 4px;">
            <div style="display: flex; gap: 10px; align-items: flex-start;">
                <span style="font-size: 1.5rem; line-height: 1;">⚠️</span>
                <div style="font-size: 0.95rem; color: #856404;">
                    <strong>¡IMPORTANTE!</strong> Todo documento dirigido al <strong>Órgano de Control Institucional de AGRO RURAL</strong> debe ser canalizado exclusivamente a través de la Mesa de Partes de la <strong>CONTRALORÍA GENERAL DE LA REPÚBLICA</strong>, mediante el siguiente enlace:
                    <a href="https://mesadepartesvirtual.contraloria.gob.pe/mpvirtual/" target="_blank" rel="noopener noreferrer" style="font-weight: bold; color: #533f03; text-decoration: underline;">
                        https://mesadepartesvirtual.contraloria.gob.pe/mpvirtual/
                    </a>
                </div>
            </div>
        </div>


        <div class="ux-card-form">
            <h2>I. DATOS DE LA EMPRESA</h2>

            <div class="ux-grid-form">
                <div class="ux-field">
                    <label>RUC *</label>
                    <div class="ux-input-group">
                        <input @bind="formulario.vRucEmpresa" @oninput="OnRucInputChanged" placeholder="Ingrese RUC" maxlength="11"
                               onkeypress="return event.charCode >= 48 && event.charCode <= 57"
                               disabled="@isProcessing" />

                        <button type="button" class="ux-btn-primary" @onclick="ValidarRuc" disabled="@isProcessing">
                            @(isProcessing ? "Validando..." : "Validar")
                        </button>
                    </div>

                    <!-- Error personalizado o el que genere tu función ValidarRuc -->
                    @if (!string.IsNullOrEmpty(rucErrorMsg) || !string.IsNullOrEmpty(errorRuc))
                    {
                        <span class="ux-error">@(string.IsNullOrEmpty(rucErrorMsg) ? errorRuc : rucErrorMsg)</span>
                    }
                </div>

                <div class="ux-field">
                    <label>Razón Social *</label>
                    <input @bind="formulario.VRazonSocial"
                           readonly="@bloqueadoRazonSocial" style="text-transform: uppercase;"
                           class="@(bloqueadoRazonSocial ? "ux-readonly" : "")"
                           disabled="@isProcessing" />

                    @if (!string.IsNullOrEmpty(errorRazonSocial))
                    {
                        <span class="ux-error">@errorRazonSocial</span>
                    }
                </div>
            </div>
        </div>
        
        <div class="ux-card-form">
            <h2>II. DATOS DEL REPRESENTANTE LEGAL</h2>

            <div class="ux-grid-form">

                <div class="ux-field">
                    <label>Tipo de Documento *</label>
                    <select @bind="formulario.ICodTipoDocPer" @bind:after="OnTipoDocumentoChange">
                        <option value="0">-- SELECCIONE --</option>
                        <option value="1">DNI</option>
                        <option value="3">CE (Carnet de Extranjería)</option>
                    </select>
                    @if (!string.IsNullOrEmpty(errorTipoDoc))
                    {
                        <span class="ux-error">@errorTipoDoc</span>
                    }
                </div>

                <div class="ux-field">
                    <label>Nro. Documento *</label>
                    <input @bind="formulario.VDocPer"
                           @bind:after="ValidarDocumento"
                           maxlength="@(formulario.ICodTipoDocPer == 1 ? "8" : "10")"
                           onkeypress="return event.charCode >= 48 && event.charCode <= 57"
                           placeholder="@(formulario.ICodTipoDocPer == 1 ? "Ingresar Número de DNI" : "Ingresar Número de Carnet de Extranjería")" />

                    @if (!string.IsNullOrEmpty(errorDocumento))
                    {
                        <span class="ux-error">@errorDocumento</span>
                    }
                </div>

                @if (formulario.ICodTipoDocPer == 1)
                {
                    <div class="ux-field ux-field-button full-width">
                        <button class="ux-btn-primary" @onclick="ValidarDatos">
                            Validar datos
                        </button>
                    </div>
                }

                
                <div class="ux-field">
                    <label>Apellido Paterno *</label>
                    <input @bind="formulario.VApellidoPaterno" disabled="@bloquearDatos" style="text-transform: uppercase;" />
                    @if (!string.IsNullOrEmpty(errorPaterno))
                    {
                        <span class="ux-error">@errorPaterno</span>
                    }
                </div>

                <div class="ux-field">
                    <label>Apellido Materno *</label>
                    <input @bind="formulario.VApellidoMaterno" disabled="@bloquearDatos" style="text-transform: uppercase;" />
                    @if (!string.IsNullOrEmpty(errorMaterno))
                    {
                        <span class="ux-error">@errorMaterno</span>
                    }
                </div>

                <div class="ux-field">
                    <label>Nombres *</label>
                    <input @bind="formulario.VNombres" disabled="@bloquearDatos" style="text-transform: uppercase;" />
                    @if (!string.IsNullOrEmpty(errorNombres))
                    {
                        <span class="ux-error">@errorNombres</span>
                    }
                </div>

                <div class="ux-field">
                    <label>Teléfono *</label>
                    <input @bind="formulario.VTelefono"
                           @bind:after="LimpiarErrorTelefono"
                           onkeypress="return event.charCode >= 48 && event.charCode <= 57" />
                    @if (!string.IsNullOrEmpty(errorTelefono))
                    {
                        <span class="ux-error">@errorTelefono</span>
                    }
                </div>

                <div class="ux-field">
                    <label>Correo *</label>
                    <div style="display: flex; flex-wrap: wrap; gap: 10px; width: 100%; text-transform: uppercase;">
                        <input type="email"
                               @bind="formulario.VEmail"
                               @bind:after="ValidarCorreo"
                               placeholder="ejemplo@correo.com"
                               style="flex: 1 1 200px; min-width: 0;"
                               disabled="@(codigoVerificado || enviandoCorreo)" />

                        <button type="button"
                                class="ux-btn-secondary"
                                @onclick="GenerarCodigoVerificacion"
                                style="flex: 0 0 auto; min-width: 140px; white-space: nowrap;"
                                disabled="@(string.IsNullOrEmpty(formulario.VEmail) || !string.IsNullOrEmpty(errorCorreo) || codigoVerificado || enviandoCorreo)">
                            @(enviandoCorreo ? "Enviando..." : "Generar Código")
                        </button>
                    </div>

                    @if (!string.IsNullOrEmpty(errorCorreo))
                    {
                        <span class="ux-error">@errorCorreo</span>
                    }
                    @if (!string.IsNullOrEmpty(mensajeCodigo))
                    {
                        <span style="color: #2e7d32; font-size: 0.85rem; margin-top: 4px; display: block;">@mensajeCodigo</span>
                    }
                </div>

                @if (mostrarCampoCodigo)
                {
                    <div class="ux-field">
                        <label>Ingresa código generado *</label>

                        <!-- Contenedor flexible para el input y su propio botón de Validar -->
                        <div style="display: flex; flex-wrap: wrap; gap: 10px; width: 100%; margin-top: 5px;">
                            <div style="position: relative; flex: 1 1 200px; min-width: 0;">
                                <input type="text"
                                       @bind="codigoIngresado"
                                       maxlength="6"
                                       placeholder="AQUÍ LOS 6 DÍGITOS"
                                       style="width: 100%; padding-right: 40px; height: 100%;"
                                       disabled="@codigoVerificado" />

                                @if (codigoVerificado)
                                {
                                    <span style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); color: #2e7d32; font-weight: bold;">
                                        ✅
                                    </span>
                                }
                            </div>

                            <!-- Botón explícito para validar el código -->
                            <button type="button"
                                    class="ux-btn-secondary"
                                    @onclick="VerificarCodigo"
                                    style="flex: 0 0 auto; min-width: 140px; white-space: nowrap;"
                                    disabled="@(string.IsNullOrEmpty(codigoIngresado) || codigoIngresado.Length < 6 || codigoVerificado || verificandoCodigo)">
                                @(verificandoCodigo ? "Validando..." : "Validar Código")
                            </button>
                        </div>

                        @if (!string.IsNullOrEmpty(errorCodigo))
                        {
                            <span class="ux-error" style="display: block; margin-top: 4px;">@errorCodigo</span>
                        }
                    </div>
                }

                
                <div class="ux-field">
                    <label>Dirección *</label>
                    <input @bind="formulario.VDireccion"
                           @bind:after="LimpiarErrorDireccion"
                           placeholder="Ej: Av. Arequipa 123..." style="text-transform: uppercase;" />
                    <small class="ux-help">Ingrese vía, número, interior/departamento, urbanización o AA.HH.</small>
                    @if (!string.IsNullOrEmpty(errorDireccion))
                    {
                        <span class="ux-error">@errorDireccion</span>
                    }
                </div>

                <div class="ux-field">
                    <label>Departamento *</label>
                    <select @bind="departamentoSeleccionado" @bind:after="OnDepartamentoChanged">
                        <option value="">-- SELECCIONAR --</option>
                        @if (ListaDepartamentos != null)
                        {
                            @foreach (var dept in ListaDepartamentos)
                            {
                                <option value="@dept.vCodigo">@dept.vDescripcion</option>
                            }
                        }
                    </select>
                    @if (!string.IsNullOrEmpty(errorDepartamento))
                    {
                        <span class="ux-error">@errorDepartamento</span>
                    }
                </div>

                <div class="ux-field">
                    <label>Provincia *</label>
                    <select @bind="provinciaSeleccionada" @bind:after="OnProvinciaChanged" disabled="@(string.IsNullOrEmpty(departamentoSeleccionado))">
                        <option value="">-- SELECCIONAR --</option>
                        @if (ListaProvincias != null)
                        {
                            @foreach (var prov in ListaProvincias)
                            {
                                <option value="@prov.vCodigo">@prov.vDescripcion</option>
                            }
                        }
                    </select>
                    @if (!string.IsNullOrEmpty(errorProvincia))
                    {
                        <span class="ux-error">@errorProvincia</span>
                    }
                </div>

                <div class="ux-field">
                    <label>Distrito *</label>
                    <select @bind="formulario.VCodDistrito"
                            @bind:after="LimpiarErrorDistrito"
                            disabled="@(string.IsNullOrEmpty(provinciaSeleccionada))">
                        <option value="">-- SELECCIONAR --</option>
                        @if (ListaDistritos != null)
                        {
                            @foreach (var dist in ListaDistritos)
                            {
                                <option value="@dist.vCodigo" style="text-transform: uppercase;">@dist.vDescripcion</option>
                            }
                        }
                    </select>
                    @if (!string.IsNullOrEmpty(errorDistrito))
                    {
                        <span class="ux-error">@errorDistrito</span>
                    }
                </div>

            </div>
    
        </div>

        <div class="ux-card-form">
            <h2>III. DATOS DEL DOCUMENTO</h2>
            <div class="ux-grid-form">                
                <div class="ux-field">
                    <label>Tipo de Documento *</label>
                    <select @bind="formulario.ICodTipoDoc" @bind:after="LimpiarErrorTipoDocTramite">
                        <option value="0">--SELECCIONAR--</option>
                        @foreach (var doc in listaTiposDocumento)
                        {
                            <option value="@doc.iCodTipoDoc">@doc.vNombreTipoDoc</option>
                        }
                    </select>
                    @if (!string.IsNullOrEmpty(errorTipoDocTramite))
                    {
                        <span class="ux-error">@errorTipoDocTramite</span>
                    }
                </div>

                <div class="ux-field">
                    <label>Nro Documento *</label>
                    <input placeholder="Ej: 001-2024" @bind="formulario.VNroDoc" @bind:after="LimpiarErrorNroDocTramite" style="text-transform: uppercase;" />
                    @if (!string.IsNullOrEmpty(errorNroDocTramite))
                    {
                        <span class="ux-error">@errorNroDocTramite</span>
                    }
                </div>

                <div class="ux-field">
                    <label>Folio *</label>
                    <input @bind="formulario.VNroPagFolios" @bind:after="LimpiarErrorFolios" placeholder="Ej: 15" onkeypress="return event.charCode >= 48 && event.charCode <= 57" />
                    @if (!string.IsNullOrEmpty(errorFolios))
                    {
                        <span class="ux-error">@errorFolios</span>
                    }
                </div>

                <div class="ux-field">
                    <label>Fecha del Documento *</label>
                    <input type="date" @bind="formulario.DFecDoc" @bind:after="LimpiarErrorFechaDoc" />
                    @if (!string.IsNullOrEmpty(errorFechaDoc))
                    {
                        <span class="ux-error">@errorFechaDoc</span>
                    }
                </div>

                <div class="ux-field full">
                    <label>Asunto / Sumilla *</label>
                    <textarea maxlength="255" @bind="formulario.VNombreAsunto" @bind:after="LimpiarErrorAsunto" placeholder="Ingrese el resumen o asunto del documento..." style="text-transform: uppercase;"></textarea>
                    @if (!string.IsNullOrEmpty(errorAsunto))
                    {
                        <span class="ux-error">@errorAsunto</span>
                    }
                </div>

                <div class="ux-field full">
                    <label>Referencia</label>
                    <input @bind="formulario.VReferencia" placeholder="Ej: Exp. Anterior N° 4521" style="text-transform: uppercase;" />
                </div>
            </div>
        </div>

        <div class="ux-card-form">
            <h2>Documento adjunto</h2>

            <!-- InputFile condicionado: si no hay archivo válido, se muestra el selector -->
            @if (archivo.Contenido == null || archivo.Contenido.Length == 0)
            {
                <div class="ux-upload-area">
                    <InputFile @key="inputKey" OnChange="OnFileSelected" accept=".pdf" class="form-control" />
                </div>
            }

            <p class="ux-file-hint">
                (Peso máximo: 50MB. Solo se permite archivos en formato PDF)
            </p>

            <!-- La tarjeta verde y el visor solo se pintan si el archivo pasó todas las validaciones -->
            @if (archivo != null && archivo.Contenido != null && archivo.Contenido.Length > 0)
            {
                <div class="ux-file-info-container" style="display: flex; justify-content: space-between; align-items: center; background: #e8f5e9; padding: 10px; border-radius: 8px;">
                    <div class="ux-file-info" style="font-weight: 600; color: #2e7d32;">
                        ✅ <span>@archivo.Nombre</span> (@archivo.Tamano)
                    </div>
                    <button type="button" class="ux-btn-delete" @onclick="RemoverArchivo" style="background: none; border: none; cursor: pointer; color: #d33; font-weight: bold;">
                        ❌ Quitar
                    </button>
                </div>

                <div class="ux-pdf-preview" style="margin-top: 15px; height: 400px; border: 1px solid #ddd;">
                    <iframe src="@($"data:application/pdf;base64,{Convert.ToBase64String(archivo.Contenido)}")" width="100%" height="100%"></iframe>
                </div>
            }
        </div>

        <div class="ux-card-form">
            <h2>Anexos</h2>

            <!-- InputFile múltiple con el diseño unificado -->
            <div class="ux-upload-area">
                <InputFile @key="inputAnexosKey"
                           multiple
                           accept=".pdf"
                           class="form-control"
                           OnChange="HandleFilesSelected" />
            </div>

            @if (!string.IsNullOrEmpty(errorArchivo))
            {
                <div class="ux-error" style="color: red; margin: 10px 0;">
                    <strong>¡Atención!</strong> @errorArchivo
                </div>
            }

            <p class="ux-file-hint">
                (Peso máximo de cada archivo: 20MB) (Formato permitido: <b>PDF</b>) (Número máximo de anexos: 10)
            </p>

            <div class="ux-table-wrapper" style="margin-top: 15px;">
                <table class="ux-table">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Tamaño</th>
                            <th style="text-align: center;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (archivos.Any())
                        {
                            @foreach (var archi in archivos)
                            {
                                <tr>
                                    <td>📄 @archi.Nombre</td>
                                    <td>@archi.Tamano</td>
                                    <td style="text-align: center; display: flex; gap: 8px; justify-content: center;">
                                        <!-- Botón de Vista Previa -->
                                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => VerPreviewAnexo(archi)" style="padding: 2px 10px; font-size: 0.85rem;">
                                            Ver
                                        </button>
                                        <!-- Botón Eliminar -->
                                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => EliminarArchivo(archi)" style="padding: 2px 10px; font-size: 0.85rem;">
                                            Eliminar
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="ux-empty" style="text-align: center; color: #64748b; padding: 20px;">
                                    No hay archivos anexos cargados
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <hr class="ux-divider" />



            <div class="ux-nota">
                <strong>Nota:</strong><br />
                El número del expediente de la presente solicitud será notificado al correo electrónico consignado en el presente formulario.
            </div>

            <hr class="ux-divider" />

            <!-- BLOQUE DE CHECKBOXES OBLIGATORIOS -->
            <DeclaracionesLegales AceptaTerminos="aceptaTerminos"
                                  AceptaTerminosChanged="(valor => aceptaTerminos = valor)"
                                  AceptaDatosPersonales="aceptaDatosPersonales"
                                  AceptaDatosPersonalesChanged="(valor => aceptaDatosPersonales = valor)" />
            <!-- FIN DEL BLOQUE -->

            <div class="ux-actions">
                <button class="ux-button-secondary" @onclick="ManejarVolver">
                    ← Volver
                </button>

                <button class="ux-btn-primary" @onclick="Finalizar">
                    Enviar solicitud
                </button>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(previewUrl))
        {
            <div class="ux-modal-overlay" @onclick="CerrarPreview">
                <div class="ux-modal-content" @onclick:stopPropagation="true">
                    <button class="ux-close" @onclick="CerrarPreview">✖</button>
                    <div class="ux-iframe-wrapper">
                        <iframe src="@previewUrl"></iframe>
                    </div>
                </div>
            </div>
        }


    </div>

</div>


@code {
    [Parameter] public EventCallback OnVolver { get; set; }
    private async Task ManejarVolver()
    {
        // Intentamos notificar al padre primero
        if (OnVolver.HasDelegate)
        {
            await OnVolver.InvokeAsync();
        }
        else
        {
            // Si no hay padre escuchando (caso de error), redirigimos a la ruta segura
            // Nav.NavigateTo("/Tramitar", true);
            Ir($"/", true);

        }
    }

    // ********************** 
    // I. DATOS DE LA EMPRESA
    // ********************** 
    private bool isProcessing = false;
    private bool bloqueadoRazonSocial = true;
    private string rucErrorMsg;

    private async Task ValidarRuc()
    {
        if (string.IsNullOrWhiteSpace(formulario.vRucEmpresa) || formulario.vRucEmpresa.Length != 11)
        {
            rucErrorMsg = "El RUC debe tener 11 dígitos.";
            return;
        }

        isProcessing = true;
        rucErrorMsg = string.Empty;
        errorRazonSocial = string.Empty; // 👈 AGREGA ESTO AQUÍ PARA LIMPIAR EL ERROR

        try
        {
            var resultado = await Http.GetFromJsonAsync<ContribuyenteDto>($"api/personas/juridica?documento={formulario.vRucEmpresa}");

            if (resultado != null)
            {
                formulario.VRazonSocial = resultado.nombreRazonSocial;
                bloqueadoRazonSocial = true;
                errorRazonSocial = string.Empty; // 👈 Y ASEGÚRATE DE LIMPIARLO AQUÍ TAMBIÉN
            }
            else
            {
                rucErrorMsg = "No se encontró información para este RUC.";
                bloqueadoRazonSocial = false;
            }
        }
        catch (Exception)
        {
            rucErrorMsg = "No se encontró información para este RUC. Ingrese el nombre manualmente.";
        }
        finally
        {
            isProcessing = false;
            StateHasChanged(); // 👈 Refresca la pantalla para que el error rojo se oculte al instante
        }
    }

    private void OnRucInputChanged(ChangeEventArgs e)
    {
        // Al cambiar el RUC, reseteamos la Razón Social en el formulario
        formulario.VRazonSocial = string.Empty;
        bloqueadoRazonSocial = false;
    }

    private string errorRuc = "";
    private string errorRazonSocial = "";

    private bool ValidarEmpresa()
    {
        rucErrorMsg = "";
        errorRazonSocial = "";
        bool esValido = true;

        // 1. Validar RUC vacío o incompleto
        if (string.IsNullOrWhiteSpace(formulario.vRucEmpresa))
        {
            rucErrorMsg = "El RUC es obligatorio.";
            esValido = false;
        }
        else if (formulario.vRucEmpresa.Length != 11 || !formulario.vRucEmpresa.All(char.IsDigit))
        {
            rucErrorMsg = "El RUC debe tener exactamente 11 dígitos.";
            esValido = false;
        }

        // 2. Validar Razón Social
        if (string.IsNullOrWhiteSpace(formulario.VRazonSocial))
        {
            errorRazonSocial = "La Razón Social es obligatoria.";
            esValido = false;
        }

        StateHasChanged();

        // 💡 ESTE RETURN AL FINAL EVITA EL ERROR DE COMPILACIÓN
        return esValido;
    }

    // *********************************
    // II. DATOS DEL REPRESENTANTE LEGAL
    // *********************************

    private InicioPersJuridicaDto formulario = new();
    private PersonaNaturalDto? personaConsultada;

    private string errorDocumento = "";
    private bool bloquearDatos = true;

    private void OnTipoDocumentoChange()
    {
        formulario.VDocPer = "";
        errorDocumento = "";
        errorTipoDoc = "";
        formulario.VApellidoPaterno = "";
        formulario.VApellidoMaterno = "";
        formulario.VNombres = "";
        bloquearDatos = (formulario.ICodTipoDocPer == 0 || formulario.ICodTipoDocPer == 1);
    }

    private void ValidarDocumento()
    {
        errorDocumento = "";

        if (string.IsNullOrWhiteSpace(formulario.VDocPer))
        {
            errorDocumento = "El número de documento es obligatorio.";
            return;
        }

        if (formulario.ICodTipoDocPer == 1) // DNI
        {
            if (formulario.VDocPer.Length != 8)
            {
                errorDocumento = "El DNI debe tener exactamente 8 dígitos numéricos.";
            }
        }
        else if (formulario.ICodTipoDocPer == 3) // CE
        {
            if (formulario.VDocPer.Length > 10)
            {
                errorDocumento = "El Carnet de Extranjería (CE) no puede superar los 10 caracteres.";
            }
        }
    }

    private async Task ValidarDatos()
    {
        errorDocumento = "";
        errorPaterno = "";
        errorMaterno = "";
        errorNombres = "";

        // 1. Validaciones de formulario
        if (string.IsNullOrEmpty(formulario.VDocPer))
        {
            errorDocumento = "Debe ingresar un número de documento.";
            return;
        }

        if (formulario.ICodTipoDocPer == 1 && (formulario.VDocPer.Length != 8 || !formulario.VDocPer.All(char.IsDigit)))
        {
            errorDocumento = "DNI inválido.";
            return;
        }

        try
        {
            // 2. Llamada al API
            string url = $"api/personas/natural?tipoDocumento={formulario.ICodTipoDocPer}&documento={formulario.VDocPer}";

            var personaEncontrada = await Http.GetFromJsonAsync<PersonaNaturalDto>(url);

            // 3. Lógica de asignación
            if (personaEncontrada != null && !string.IsNullOrEmpty(personaEncontrada.vDocPer))
            {
                formulario.ICodPer = personaEncontrada.iCodPer;
                formulario.VApellidoPaterno = personaEncontrada.vApellidoPaterno;
                formulario.VApellidoMaterno = personaEncontrada.vApellidoMaterno;
                formulario.VNombres = personaEncontrada.vNombres;

                bloquearDatos = true;

                // 👈 Vuelve a asegurar que se limpien los errores por si acaso
                errorPaterno = "";
                errorMaterno = "";
                errorNombres = "";
            }
            else
            {
                LimpiarFormularioPersona("Documento no registrado. Complete sus datos manualmente.");
            }
        }
        catch (HttpRequestException ex)
        {
            if (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                LimpiarFormularioPersona("Documento no registrado. Complete sus datos manualmente.");
            }
            else
            {
                Console.WriteLine($"[ValidarDatos] 🚨 ERROR: {ex.Message}");
                errorDocumento = "Error de conexión con el servidor.";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ValidarDatos] 🚨 ERROR DESCONOCIDO: {ex.Message}");
            errorDocumento = "Documento no registrado. Complete sus datos manualmente.";
            bloquearDatos = false;
            formulario.VApellidoPaterno = "";
            formulario.VApellidoMaterno = "";
            formulario.VNombres = "";
        }

        StateHasChanged();
    }

    // Método auxiliar para limpiar los campos y desbloquear
    private void LimpiarFormularioPersona(string mensaje)
    {
        errorDocumento = mensaje;
        formulario.VApellidoPaterno = "";
        formulario.VApellidoMaterno = "";
        formulario.VNombres = "";
        formulario.ICodPer = 0;
        bloquearDatos = false;
    }

    private string errorTipoDoc = "";
    private string errorPaterno = "";
    private string errorMaterno = "";
    private string errorNombres = "";
    private string errorTelefono = "";
    private string errorDireccion = "";
    private string errorDepartamento = "";
    private string errorProvincia = "";
    private string errorDistrito = "";

    private bool ValidarFormularioRemitente()
    {
        // Limpiamos mensajes previos
        errorDocumento = "";
        errorTipoDoc = "";
        errorPaterno = "";
        errorMaterno = "";
        errorNombres = "";
        errorTelefono = "";
        errorCorreo = "";
        errorDireccion = "";
        errorDepartamento = "";
        errorProvincia = "";
        errorDistrito = "";
        errorCodigo = "";

        bool esValido = true;

        // 1. Tipo de Documento
        if (formulario.ICodTipoDocPer <= 0)
        {
            errorTipoDoc = "Debe seleccionar un tipo de documento.";
            esValido = false;
        }

        // 2. Número de Documento
        if (string.IsNullOrWhiteSpace(formulario.VDocPer))
        {
            errorDocumento = "El número de documento es obligatorio.";
            esValido = false;
        }
        else if (formulario.ICodTipoDocPer == 1 && (formulario.VDocPer.Length != 8 || !formulario.VDocPer.All(char.IsDigit)))
        {
            errorDocumento = "El DNI debe tener exactamente 8 dígitos numéricos.";
            esValido = false;
        }
        else if (formulario.ICodTipoDocPer == 3 && formulario.VDocPer.Length > 10)
        {
            errorDocumento = "El Carnet de Extranjería no puede superar los 10 caracteres.";
            esValido = false;
        }

        // 3. Apellidos y Nombres
        if (string.IsNullOrWhiteSpace(formulario.VApellidoPaterno))
        {
            errorPaterno = "El apellido paterno es obligatorio.";
            esValido = false;
        }

        if (string.IsNullOrWhiteSpace(formulario.VApellidoMaterno))
        {
            errorMaterno = "El apellido materno es obligatorio.";
            esValido = false;
        }

        if (string.IsNullOrWhiteSpace(formulario.VNombres))
        {
            errorNombres = "Los nombres son obligatorios.";
            esValido = false;
        }

        // 4. Teléfono
        if (string.IsNullOrWhiteSpace(formulario.VTelefono))
        {
            errorTelefono = "El teléfono es obligatorio.";
            esValido = false;
        }

        // 5. Correo y Código de Verificación OTP
        if (string.IsNullOrWhiteSpace(formulario.VEmail))
        {
            errorCorreo = "El correo electrónico es obligatorio.";
            esValido = false;
        }
        else
        {
            ValidarCorreo();
            if (!string.IsNullOrEmpty(errorCorreo)) esValido = false;
        }

        if (!codigoVerificado)
        {
            errorCodigo = "Debe validar el código de 6 dígitos enviado a su correo.";
            esValido = false;
        }

        // 6. Dirección
        if (string.IsNullOrWhiteSpace(formulario.VDireccion))
        {
            errorDireccion = "La dirección domiciliaria es obligatoria.";
            esValido = false;
        }

        // 7. Ubigeo (Departamento, Provincia, Distrito)
        if (string.IsNullOrWhiteSpace(departamentoSeleccionado))
        {
            errorDepartamento = "Debe seleccionar un departamento.";
            esValido = false;
        }

        if (string.IsNullOrWhiteSpace(provinciaSeleccionada))
        {
            errorProvincia = "Debe seleccionar una provincia.";
            esValido = false;
        }

        if (string.IsNullOrWhiteSpace(formulario.VCodDistrito))
        {
            errorDistrito = "Debe seleccionar un distrito.";
            esValido = false;
        }

        StateHasChanged();
        return esValido;
    }

    private void LimpiarErrorTelefono() { if (!string.IsNullOrWhiteSpace(formulario.VTelefono)) errorTelefono = ""; }
    private void LimpiarErrorDireccion() { if (!string.IsNullOrWhiteSpace(formulario.VDireccion)) errorDireccion = ""; }
    private void LimpiarErrorDistrito() { if (!string.IsNullOrEmpty(formulario.VCodDistrito)) errorDistrito = ""; }

    // CORREO
    private string errorCorreo = "";
    private void ValidarCorreo()
    {
        errorCorreo = "";
        formulario.VEmail = formulario.VEmail?.Trim() ?? string.Empty;

        if (string.IsNullOrWhiteSpace(formulario.VEmail))
        {
            errorCorreo = "El correo electrónico es obligatorio.";
            return;
        }

        var regexEmail = new System.Text.RegularExpressions.Regex(@"^[^@\s]+@[^@\s]+\.[^@\s]+$");

        if (!regexEmail.IsMatch(formulario.VEmail))
        {
            errorCorreo = "El formato del correo electrónico no es válido.";
        }
    }

    private bool codigoVerificado = false;
    private bool enviandoCorreo = false;
    private string errorCodigo = "";
    private string mensajeCodigo = "";
    private bool mostrarCampoCodigo = false;

    private async Task GenerarCodigoVerificacion()
    {
        errorCodigo = "";
        errorCorreo = "";
        mensajeCodigo = "";
        enviandoCorreo = true;

        try
        {
            var response = await Http.PostAsJsonAsync("api/correos/otp", new { Correo = formulario.VEmail });

            if (response.IsSuccessStatusCode)
            {
                mostrarCampoCodigo = true;
                mensajeCodigo = $"Se ha enviado un código de verificación a {formulario.VEmail.ToLower()}.";
            }
            else
            {
                errorCorreo = "No se pudo generar el código.";
            }
        }
        finally
        {
            enviandoCorreo = false;
            StateHasChanged();
        }
    }

    private string codigoIngresado = "";
    private bool verificandoCodigo = false; // Indicador visual opcional mientras valida

    private async Task VerificarCodigo()
    {
        errorCodigo = "";

        if (string.IsNullOrEmpty(codigoIngresado) || codigoIngresado.Length < 6)
        {
            errorCodigo = "El código debe tener 6 dígitos.";
            return;
        }

        verificandoCodigo = true;

        try
        {
            var request = new { Correo = formulario.VEmail, Codigo = codigoIngresado };
            var response = await Http.PostAsJsonAsync("api/correos/verificar", request);

            if (response.IsSuccessStatusCode)
            {
                codigoVerificado = true;
                mensajeCodigo = "¡Código Aprobado! ✅ El correo ha sido validado.";
                mostrarCampoCodigo = false; // Oculta el campo tras éxito
            }
            else
            {
                codigoVerificado = false;
                errorCodigo = "El código ingresado es incorrecto o ha expirado.";
            }
        }
        catch (Exception ex)
        {
            errorCodigo = "Error de conexión con el servicio de validación.";
            Console.WriteLine($"[Error]: {ex.Message}");
        }
        finally
        {
            verificandoCodigo = false;
            StateHasChanged();
        }
    }


