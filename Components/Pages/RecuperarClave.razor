@rendermode InteractiveServer
@using MesaPartesDigital.Models
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JS

<button type="button" class="neo-link-btn" @onclick="ProcesarRecuperacionClave" disabled="@isProcessing">
    @if (isProcessing)
    {
        <span class="neo-spinner"></span>
        <span>Procesando...</span>
    }
    else
    {
        <span>¿Olvidaste tu contraseña? Genera una nueva</span>
    }
</button>

@if (!string.IsNullOrEmpty(mensajeAlert))
{
    <div class="neo-alert-msg msg-error">
        <span>⚠️</span>
        <div>@mensajeAlert</div>
    </div>
}


@code {

    private string documento = string.Empty;
    private string mensajeAlert = string.Empty;
    private bool isProcessing = false;

    private async Task ProcesarRecuperacionClave()
    {
        // Pedimos el DNI vía prompt de SweetAlert, ya que este componente
        // no comparte el modelo del formulario estático de Login.razor.
        var input = await JS.InvokeAsync<string?>("eval", @"
         new Promise(resolve => {
                Swal.fire({
                    html: `
                        <div style='text-align: left; padding: 10px 5px; font-family: system-ui, -apple-system, sans-serif;'>
                            <div style='display: flex; align-items: center; gap: 14px; margin-bottom: 20px;'>
                                <div style='background-color: #eff6ff; color: #3b82f6; width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 24px; flex-shrink: 0; box-shadow: 0 2px 4px rgba(59, 130, 246, 0.1);'>
                                    🔑
                                </div>
                                <div>
                                    <h3 style='margin: 0; font-size: 18px; font-weight: 700; color: #1e293b;'>Recuperar Contraseña</h3>
                                    <p style='margin: 2px 0 0 0; font-size: 13px; color: #64748b;'>Verificación de Identidad</p>
                                </div>
                            </div>
                            <p style='font-size: 14px; color: #475569; line-height: 1.5; margin-bottom: 15px;'>
                                Ingresa tu número de DNI o CE para proceder con la recuperación de tu cuenta.
                            </p>
                        </div>
                    `,
                    input: 'text',
                    inputAttributes: { 
                        maxlength: '12',
                        placeholder: 'Ej. 12345678',
                        style: 'border-radius: 8px; border: 1px solid #cbd5e1; padding: 10px 14px; font-size: 14px;'
                    },
                    showCancelButton: true,
                    confirmButtonText: 'Continuar',
                    cancelButtonText: 'Cancelar',
                    confirmButtonColor: '#1e293b',
                    cancelButtonColor: '#64748b',
                    backdrop: 'rgba(15, 23, 42, 0.5)',
                    customClass: {
                        popup: 'rounded-2xl shadow-xl border border-slate-100'
                    }
                }).then(result => resolve(result.isConfirmed ? result.value : null));
            })
        ");

        if (string.IsNullOrWhiteSpace(input))
        {
            return;
        }

        documento = input;
        mensajeAlert = string.Empty;
        isProcessing = true;
        StateHasChanged();

        try
        {
            var client = HttpClientFactory.CreateClient("MesaPartesApi");
            var request = new { Documento = documento, CodigoOtp = (string?)null, TipoAccion = 2 };
            var response = await client.PostAsJsonAsync("api/autenticacion/credenciales", request);
            var resultado = await response.Content.ReadFromJsonAsync<GestionCredencialesResultDto>();

            if (resultado?.Exitoso == true)
            {
                string emailDestino = resultado.EmailDestino ?? "su correo";

                await JS.InvokeVoidAsync("Swal.fire", new
                {
                    html = $@"
                            <div style='text-align: left; padding: 10px 5px; font-family: system-ui, -apple-system, sans-serif;'>
                                <div style='display: flex; align-items: center; gap: 14px; margin-bottom: 20px;'>
                                    <div style='background-color: #f0fdf4; color: #16a34a; width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 24px; flex-shrink: 0; box-shadow: 0 2px 4px rgba(22, 163, 74, 0.1);'>
                                        📬
                                    </div>
                                    <div>
                                        <h3 style='margin: 0; font-size: 18px; font-weight: 700; color: #1e293b;'>¡Contraseña Actualizada!</h3>
                                        <p style='margin: 2px 0 0 0; font-size: 13px; color: #64748b;'>Seguridad de la Cuenta</p>
                                    </div>
                                </div>
                                <p style='font-size: 14px; color: #475569; line-height: 1.5; margin-bottom: 15px;'>
                                    Hemos enviado tus nuevas credenciales de acceso de forma segura al siguiente correo:
                                </p>
                                <div style='background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 16px; margin-bottom: 20px;'>
                                    <div style='font-size: 14px; color: #1e293b; font-weight: 600; font-family: monospace; word-break: break-all; background: #ffffff; padding: 10px 12px; border-radius: 8px; border: 1px dashed #cbd5e1; text-align: center;'>
                                        {emailDestino}
                                    </div>
                                </div>
                                <div style='display: flex; align-items: flex-start; gap: 8px; font-size: 12px; color: #856404; background: #fff3cd; padding: 10px 12px; border-radius: 8px; border: 1px solid #ffeeba;'>
                                    <span style='flex-shrink: 0;'>⚠️</span>
                                    <span><b>Importante:</b> Si no lo encuentras en tu bandeja principal, revisa tu bandeja de <b>Correo No Deseado o SPAM</b>.</span>
                                </div>
                            </div>
                        ",
                    showConfirmButton = true,
                    confirmButtonText = "¡Entendido, gracias!",
                    confirmButtonColor = "#1e293b",
                    allowOutsideClick = false,
                    backdrop = "rgba(15, 23, 42, 0.5)",
                    customClass = new { popup = "rounded-2xl shadow-xl border border-slate-100" }
                });

                mensajeAlert = string.Empty;
            }
            else
            {
                mensajeAlert = resultado?.Mensaje ?? "Error en la solicitud.";
            }
        }
        catch (Exception)
        {
            mensajeAlert = "Error al conectar con el servidor.";
        }
        finally
        {
            isProcessing = false;
        }
    }
}
