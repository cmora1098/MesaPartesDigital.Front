    private async Task GuardarCambios()
    {
        try
        {
            // 1. Si hay nuevos anexos, los enviamos primero
            if (archivosNuevos.Any())
            {
                var responseAnexos = await Http.PostAsJsonAsync($"api/documentos/registrar-anexos/{idAsunto}", archivosNuevos);

                if (!responseAnexos.IsSuccessStatusCode)
                {
                    var errorContent = await responseAnexos.Content.ReadAsStringAsync();

                    await SweetAlertHelper.MostrarModalValidacionAsync(
                        JSRuntime,
                        titulo: "Nuevos Anexos",
                        mensajeError: "Lo sentimos, no se pudieron guardar los nuevos anexos en el sistema.",
                        etiquetaValidacion: "Error en el proceso",
                        mensajeSugerencia: "Verifique los archivos seleccionados e intente nuevamente." // 📌
                    );
                    return;
                }
            }

            // 2. Ejecutamos el cambio de estado del trámite (de 5 a 1)
            var responseEstado = await Http.PutAsync($"api/documentos/cambiar-estado/{idAsunto}", null);

            if (responseEstado.IsSuccessStatusCode)
            {
                await SweetAlertHelper.MostrarModalExitoInformativoAsync(
                    JSRuntime,
                    "¡Actualización Exitosa!",
                    "Mesa de Partes Virtual",
                    "Los cambios se guardaron y el trámite fue actualizado correctamente en el sistema.",
                    textoBotonConfirmar: "Continuar",
                    etiquetaAccion: "Actualizado con éxito",
                    mensajeAlerta: "Todas sus modificaciones ya se encuentran registradas.",
                    icono: "✅"
                ); 
                archivosNuevos.Clear();
                // Nav.NavigateTo("/Tramitar");
                Ir($"/Tramitar");
            }
            else
            {
                // LEER EL MENSAJE REAL QUE MANDA LA API
                var errorServidor = await responseEstado.Content.ReadAsStringAsync();
                await SweetAlertHelper.MostrarModalErrorAsync(
                    JSRuntime,
                    "Error de Actualización",
                    "Mesa de Partes Virtual",
                    "No se pudo completar la actualización.",
                    textoBotonConfirmar: "Entendido",
                    etiquetaAccion: "Actualización fallida",
                    mensajeAlerta: "Verifique su conexión o intente nuevamente más tarde.",
                    icono: "⚠️"
                ); 
            }
        }
        catch (Exception ex)
        {
            await SweetAlertHelper.MostrarModalErrorAsync(
                JSRuntime,
                "Error de Actualización",
                "Mesa de Partes Virtual",
                "No se pudo completar la actualización en el servidor.",
                textoBotonConfirmar: "Entendido",
                etiquetaAccion: "Actualización fallida",
                mensajeAlerta: "Verifique su conexión o intente nuevamente más tarde.",
                icono: "⚠️"
            ); 
        }
    }

