    private async Task CerrarPreview()
    {
        try
        {
            if (!string.IsNullOrWhiteSpace(previewUrl) && previewUrl.StartsWith("blob:", StringComparison.OrdinalIgnoreCase))
            {
                await JSRuntime.InvokeVoidAsync("console.log", $"[MPV EDITAR] Liberando preview: {previewUrl}");
                await JSRuntime.InvokeVoidAsync("mpvPdf.revoke", previewUrl);
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.warn", $"[MPV EDITAR] No se pudo liberar preview: {ex.Message}");
        }
        finally
        {
            previewUrl = null;
            tituloDocumentoActivo = null;
            anexoSeleccionadoRegistrado = null;
            archivoSeleccionadoNuevo = null;
            mostrarErrorModal = false;
            StateHasChanged();
        }
    }

    private async Task VerPreviewAnexoLocal(ArchivoAdjunto archi)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("console.log", $"[MPV EDITAR ANEXO LOCAL] Click Ver: {archi?.Nombre ?? "(sin nombre)"}");

            if (archi?.Contenido == null || archi.Contenido.Length == 0)
                throw new InvalidOperationException("El anexo no contiene bytes en memoria.");

            if (!string.IsNullOrWhiteSpace(previewUrl) && previewUrl.StartsWith("blob:", StringComparison.OrdinalIgnoreCase))
                await JSRuntime.InvokeVoidAsync("mpvPdf.revoke", previewUrl);

            using var memoryStream = new MemoryStream(archi.Contenido, writable: false);
            using var streamRef = new DotNetStreamReference(memoryStream);

            previewUrl = await JSRuntime.InvokeAsync<string>("mpvPdf.create", streamRef);
            mostrarErrorModal = false;

            await JSRuntime.InvokeVoidAsync("console.log", $"[MPV EDITAR ANEXO LOCAL] Blob creado: {previewUrl} | bytes={archi.Contenido.Length}");
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", $"[MPV EDITAR ANEXO LOCAL] ERROR: {ex}");
            mostrarErrorModal = true;
            previewUrl = "ERROR_FILE_NOT_FOUND";
            StateHasChanged();
        }
    }

    private async Task VerDocumento(AnexoDto anexo)
    {
        var baseUrl = Configuration["ApiSettings:BaseUrl"] ?? "https://localhost:7100/";
        if (!baseUrl.EndsWith("/")) baseUrl += "/";
        var url = $"{baseUrl}api/documentos/ver-archivo-anexo/{anexo.iCodDoc}";

        try
        {
            await JSRuntime.InvokeVoidAsync("console.log", $"[MPV EDITAR ANEXO REG] Click Ver. iCodDoc={anexo.iCodDoc}");
            await JSRuntime.InvokeVoidAsync("console.log", $"[MPV EDITAR ANEXO REG] GET {url}");

            if (!string.IsNullOrWhiteSpace(previewUrl) && previewUrl.StartsWith("blob:", StringComparison.OrdinalIgnoreCase))
                await JSRuntime.InvokeVoidAsync("mpvPdf.revoke", previewUrl);

            using var response = await Http.GetAsync(url, HttpCompletionOption.ResponseHeadersRead);
            var contentType = response.Content.Headers.ContentType?.MediaType ?? "(sin Content-Type)";
            var contentLength = response.Content.Headers.ContentLength;

            await JSRuntime.InvokeVoidAsync("console.log",
                $"[MPV EDITAR ANEXO REG] HTTP {(int)response.StatusCode} {response.StatusCode} | Content-Type={contentType} | Content-Length={contentLength?.ToString() ?? "desconocido"}");

            if (!response.IsSuccessStatusCode)
            {
                var detalle = await response.Content.ReadAsStringAsync();
                await JSRuntime.InvokeVoidAsync("console.error", $"[MPV EDITAR ANEXO REG] Error API: {detalle}");
                mostrarErrorModal = true;
                previewUrl = "ERROR_FILE_NOT_FOUND";
                StateHasChanged();
                return;
            }

            var bytes = await response.Content.ReadAsByteArrayAsync();
            await JSRuntime.InvokeVoidAsync("console.log", $"[MPV EDITAR ANEXO REG] Bytes recibidos: {bytes.Length}");

            bool firmaPdf = bytes.Length >= 5 &&
                            bytes[0] == (byte)'%' && bytes[1] == (byte)'P' &&
                            bytes[2] == (byte)'D' && bytes[3] == (byte)'F' &&
                            bytes[4] == (byte)'-';

            await JSRuntime.InvokeVoidAsync("console.log", $"[MPV EDITAR ANEXO REG] Firma PDF válida: {firmaPdf}");

            if (!firmaPdf)
            {
                var texto = System.Text.Encoding.UTF8.GetString(bytes, 0, Math.Min(bytes.Length, 500));
                await JSRuntime.InvokeVoidAsync("console.error", $"[MPV EDITAR ANEXO REG] Respuesta no PDF: {texto}");
                mostrarErrorModal = true;
                previewUrl = "ERROR_FILE_NOT_FOUND";
                StateHasChanged();
                return;
            }

            using var memoryStream = new MemoryStream(bytes, writable: false);
            using var streamRef = new DotNetStreamReference(memoryStream);
            previewUrl = await JSRuntime.InvokeAsync<string>("mpvPdf.create", streamRef);
            mostrarErrorModal = false;

            await JSRuntime.InvokeVoidAsync("console.log", $"[MPV EDITAR ANEXO REG] Blob creado: {previewUrl}");
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", $"[MPV EDITAR ANEXO REG] ERROR VerDocumento: {ex}");
            mostrarErrorModal = true;
            previewUrl = "ERROR_FILE_NOT_FOUND";
            StateHasChanged();
        }
    }

