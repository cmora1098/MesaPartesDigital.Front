    private ArchivoAdjunto archivo = new();
    private string error = "";
    private string? pdfPreviewUrl;

    private bool mostrarUrl = false;
    private void ToggleUrl() => mostrarUrl = !mostrarUrl;
    private string urlIngresada = "";

    private string? pdfActualBlobUrl;
    private bool cargandoPdfActual = false;

    private string GetApiUrl(int id)
    {
        var baseUrl = Configuration["ApiSettings:BaseUrl"] ?? "https://localhost:7100/";

        if (!baseUrl.EndsWith("/"))
            baseUrl += "/";

        return $"{baseUrl}api/documentos/ver-archivo/{id}";
    }

    protected override async Task OnParametersSetAsync()
    {
        if (tramite != null && !string.IsNullOrEmpty(tramite.RutaDocumento) && string.IsNullOrEmpty(pdfActualBlobUrl))
        {
            await CargarDocumentoActualComoBlob();
        }
    }

    private async Task CargarDocumentoActualComoBlob()
    {
        try
        {
            cargandoPreview = true;
            var urlEndpoint = GetApiUrl(tramite.iCodAsunto);

            // Descargamos los bytes del archivo actual desde la API
            var bytesPdf = await Http.GetByteArrayAsync(urlEndpoint);

            if (bytesPdf != null && bytesPdf.Length > 0)
            {
                using var stream = new MemoryStream(bytesPdf);
                using var streamRef = new DotNetStreamReference(stream);

                // Reutilizamos la función de JS para crear el Blob URL
                pdfActualBlobUrl = await JSRuntime.InvokeAsync<string>("mpvPdf.create", streamRef);
            }
        }
        catch (Exception ex)
        {
            error = "No se pudo cargar la vista previa del documento actual.";
            Console.WriteLine($"[Error Blob Actual]: {ex.Message}");
        }
        finally
        {
            cargandoPreview = false;
            StateHasChanged();
        }
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        error = string.Empty;
        cargandoPreview = true; // 1. Activamos el estado de carga al empezar
        StateHasChanged();      // Forzamos el renderizado para que aparezca el spinner

        var file = e.File;

        try
        {
            await JSRuntime.InvokeVoidAsync("console.log", "[MPV EDITAR] OnFileSelected iniciado.");
            await JSRuntime.InvokeVoidAsync("console.log", $"[MPV EDITAR] Archivo principal seleccionado: {file.Name} - {file.Size} bytes");

            if (!file.Name.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
            {
                error = "Solo se permiten archivos en formato PDF.";
                await JSRuntime.InvokeVoidAsync("console.warn", $"[MPV EDITAR] Archivo rechazado por extensión: {file.Name}");
                return;
            }

            const long maxFileSize = 50L * 1024 * 1024;
            if (file.Size > maxFileSize)
            {
                error = "El archivo supera el límite máximo de 50 MB.";
                await JSRuntime.InvokeVoidAsync("console.warn", $"[MPV EDITAR] Archivo supera 50 MB: {file.Size} bytes");
                return;
            }

            await using var stream = file.OpenReadStream(maxFileSize);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);

            await JSRuntime.InvokeVoidAsync("console.log", $"[MPV EDITAR] Lectura finalizada. Esperado={file.Size}, Recibido={ms.Length} bytes");

            if (ms.Length <= 0 || ms.Length != file.Size)
                throw new IOException($"Carga incompleta. Esperado: {file.Size} bytes; recibido: {ms.Length} bytes.");

            archivo = new ArchivoAdjunto
            {
                Nombre = "DocumentoPrincipalSubsanado.pdf",
                Tipo = file.ContentType,
                Tamano = $"{file.Size / 1024} KB",
                Contenido = ms.ToArray(),
                FileBrowser = file
            };

            if (!string.IsNullOrWhiteSpace(pdfPreviewUrl))
                await JSRuntime.InvokeVoidAsync("mpvPdf.revoke", pdfPreviewUrl);

            using var previewStream = new MemoryStream(archivo.Contenido, writable: false);
            using var streamRef = new DotNetStreamReference(previewStream);
            pdfPreviewUrl = await JSRuntime.InvokeAsync<string>("mpvPdf.create", streamRef);

            await JSRuntime.InvokeVoidAsync("console.log", $"[MPV EDITAR] Preview principal creado: {pdfPreviewUrl}");
        }
        catch (Exception ex)
        {
            error = $"Error al leer el archivo seleccionado: {ex.Message}";
            await JSRuntime.InvokeVoidAsync("console.error", $"[MPV EDITAR] ERROR OnFileSelected: {ex}");
        }
        finally
        {
            cargandoPreview = false; // 2. Desactivamos el estado de carga al terminar
            StateHasChanged();
            await JSRuntime.InvokeVoidAsync("console.log", "[MPV EDITAR] OnFileSelected finalizado.");
        }
    }

    private async Task RemoverArchivoNuevo()
    {
        try
        {
            if (!string.IsNullOrWhiteSpace(pdfPreviewUrl))
            {
                await JSRuntime.InvokeVoidAsync("mpvPdf.revoke", pdfPreviewUrl);
                await JSRuntime.InvokeVoidAsync("console.log", $"[MPV EDITAR] Preview principal liberado: {pdfPreviewUrl}");
            }
        }
        finally
        {
            pdfPreviewUrl = null;
            archivo = new ArchivoAdjunto();
            StateHasChanged();
        }
    }

    private async Task ActualizarDocumentoAdjunto()
    {
        if (archivo?.FileBrowser == null)
        {
            error = "Por favor selecciona un archivo PDF antes de actualizar.";

            await SweetAlertHelper.MostrarModalValidacionAsync(
                JSRuntime,
                titulo: "Gestión de Archivos",
                mensajeError: "Para continuar con el proceso, es necesario que seleccione un archivo válido para adjuntar.",
                etiquetaValidacion: "Ningún archivo seleccionado",
                mensajeSugerencia: "Por favor, busque y elija su documento antes de continuar." // 📌
            );
            return;
        }

        try
        {
            error = string.Empty;

            var contentType = archivo.Tipo?.ToLower() ?? string.Empty;
            var extension = Path.GetExtension(archivo.Nombre)?.ToLower() ?? string.Empty;

            bool esPdf = contentType == "application/pdf" || extension == ".pdf";
            if (!esPdf)
            {
                await SweetAlertHelper.MostrarModalValidacionAsync(
                    JSRuntime,
                    titulo: "Validación de Archivos",
                    mensajeError: "El archivo que intenta subir no cumple con las especificaciones técnicas requeridas por el sistema.",
                    etiquetaValidacion: "Solo archivos PDF (.pdf)",
                    mensajeSugerencia: "Asegúrese de que el documento tenga la extensión correcta antes de adjuntarlo." // 📌
                );
                return;
            }

            long maxFileSize = 52 * 1024 * 1024;
            if (archivo.FileBrowser.Size > maxFileSize)
            {
                await SweetAlertHelper.MostrarModalValidacionAsync(
                    JSRuntime,
                    titulo: "Control de Capacidad",
                    mensajeError: "El documento que intenta adjuntar supera el tamaño máximo permitido por el sistema.",
                    etiquetaValidacion: "Excede el límite establecido",
                    mensajeSugerencia: "Optimice, reduzca la resolución o comprima su archivo antes de volver a intentarlo." // 📌
                );
                return;
            }

            var baseUrl = Configuration["ApiSettings:BaseUrl"] ?? "https://localhost:7100/";
            if (!baseUrl.EndsWith("/")) baseUrl += "/";

            var urlEndpoint = $"{baseUrl}api/documentos/actualizar-documento-principal/{tramite?.iCodAsunto}";

            using var content = new MultipartFormDataContent();
            using var stream = archivo.FileBrowser.OpenReadStream(maxAllowedSize: maxFileSize);
            using var fileContent = new StreamContent(stream);

            fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue("application/pdf");
            content.Add(fileContent, "archivo", archivo.Nombre);

            var response = await Http.PutAsync(urlEndpoint, content);

            if (response.IsSuccessStatusCode)
            {
                error = string.Empty;

                if (!string.IsNullOrWhiteSpace(pdfActualBlobUrl))
                {
                    try { await JSRuntime.InvokeVoidAsync("mpvPdf.revoke", pdfActualBlobUrl); } catch { }
                    pdfActualBlobUrl = null;
                }

                if (!string.IsNullOrWhiteSpace(pdfPreviewUrl))
                {
                    try { await JSRuntime.InvokeVoidAsync("mpvPdf.revoke", pdfPreviewUrl); } catch { }
                    pdfPreviewUrl = null;
                }

                archivo = new();

                tramite = await Http.GetFromJsonAsync<AsuntoEdicionDto>($"api/documentos/DatosRegistrados/{idAsunto}");

                if (tramite != null)
                {
                    await CargarDocumentoActualComoBlob();
                }

                StateHasChanged();

                // 2. Alerta de éxito con los dos botones de decisión
                var successResult = await SweetAlertHelper.MostrarModalExitoAccionAsync(
                                        JSRuntime,
                                        "¡Documento Principal Actualizado!", // Título
                                        "Mesa de Partes Virtual", //Sub Título
                                        "El documento principal se ha procesado y actualizado correctamente en el sistema. ¿Deseas enviar el trámite para levantar la observación o prefieres seguir editando?", // Mensaje Principal
                                        "Guardado parcial", //Estado de la Selección
                                        "Enviar Trámite Subsanado", // Botón accíón
                                        "Seguir editando",
                                        "Los cambios ya se encuentran reflejados en su trámite.", // Mensaje Secundario
                                        "📄" // Ícono
                                    );

                // 3. Evaluamos la decisión del usuario
                if (successResult.IsConfirmed)
                {
                    // Dispara directamente tu función de ActualizarEstado() (la que cambia el estado y levanta la observación)
                    await GuardarCambios();
                }
                else if (successResult.IsDenied)
                {
                    // Simplemente se queda en la vista actual para seguir editando otros módulos
                    Console.WriteLine("[DEBUG] El usuario optó por seguir editando.");
                }
                 
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"[ERROR API] {errorContent}");
                await SweetAlertHelper.MostrarModalErrorAsync(
                    JSRuntime,
                    "Error de Actualización",
                    "Mesa de Partes Virtual",
                    "Lo sentimos, no se pudo procesar la actualización del documento adjunto en este momento.",
                    textoBotonConfirmar: "Entendido",
                    etiquetaAccion: "Error en el servidor",
                    mensajeAlerta: "Por favor, verifique el archivo e intente nuevamente en unos minutos.",
                    icono: "⚠️"
                );
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Error oculto]: {ex.Message}");
            await SweetAlertHelper.MostrarModalErrorAsync(
                JSRuntime,
                "Error de Actualización",
                "Mesa de Partes Virtual",
                "No se pudo completar la actualización en el servidor.",
                textoBotonConfirmar: "Entendido",
                etiquetaAccion: "Actualización fallida",
                mensajeAlerta: "Por favor, comprima su documento o seleccione uno más ligero antes de reintentar.",
                icono: "⚠️"
            );
        }
    }

