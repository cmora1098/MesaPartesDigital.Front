    private async Task HandleFilesSelected(InputFileChangeEventArgs e)
    {
        errorArchivo = string.Empty;
        cargandoArchivos = true; // Activar indicador

        try
        {
            var archivosSeleccionados = e.GetMultipleFiles(10);
            await JSRuntime.InvokeVoidAsync("console.log", $"[MPV EDITAR ANEXOS] Seleccionados: {archivosSeleccionados.Count}");

            foreach (var file in archivosSeleccionados)
            {
                await JSRuntime.InvokeVoidAsync("console.log", $"[MPV EDITAR ANEXOS] Procesando: {file.Name} - {file.Size} bytes");

                if (file.Size > 20L * 1024 * 1024)
                {
                    errorArchivo = $"El archivo {file.Name} supera el límite de 20MB.";
                    await JSRuntime.InvokeVoidAsync("console.warn", $"[MPV EDITAR ANEXOS] Supera 20 MB: {file.Name}");
                    continue;
                }

                if (!file.Name.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
                {
                    errorArchivo = $"El archivo {file.Name} no es PDF.";
                    await JSRuntime.InvokeVoidAsync("console.warn", $"[MPV EDITAR ANEXOS] Extensión rechazada: {file.Name}");
                    continue;
                }

                await using var stream = file.OpenReadStream(20L * 1024 * 1024);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);

                await JSRuntime.InvokeVoidAsync("console.log", $"[MPV EDITAR ANEXOS] Lectura: {file.Name} | esperado={file.Size} | recibido={ms.Length}");

                if (ms.Length <= 0 || ms.Length != file.Size)
                {
                    errorArchivo = $"El archivo {file.Name} no se cargó completamente.";
                    await JSRuntime.InvokeVoidAsync("console.error", $"[MPV EDITAR ANEXOS] Carga incompleta: {file.Name}");
                    continue;
                }

                archivosNuevos.Add(new ArchivoAdjunto
                {
                    Nombre = file.Name,
                    Tipo = file.ContentType,
                    Tamano = $"{file.Size / 1024} KB",
                    Contenido = ms.ToArray()
                });

                await JSRuntime.InvokeVoidAsync("console.log", $"[MPV EDITAR ANEXOS] Agregado correctamente: {file.Name}");
            }
        }
        catch (Exception ex)
        {
            errorArchivo = $"Error procesando anexos: {ex.Message}";
            await JSRuntime.InvokeVoidAsync("console.error", $"[MPV EDITAR ANEXOS] ERROR HandleFilesSelected: {ex}");
        }
        finally
        {
            cargandoArchivos = false; // Desactivar indicador al finalizar
            StateHasChanged();
        } 
    }

    private void EliminarArchivoLocal(ArchivoAdjunto archivo)
    {
        archivosNuevos.Remove(archivo);
        if (archivoSeleccionadoNuevo == archivo)
        {
            _ = CerrarPreview();
        }
        StateHasChanged();
    }

    // Métodos de selección y precarga en el visor integrado de la izquierda
    private async Task SeleccionarAnexoRegistrado(AnexoDto anexo)
    {
        cargandoPreview = true;
        anexoSeleccionadoRegistrado = anexo;
        archivoSeleccionadoNuevo = null;
        StateHasChanged();

        try
        {
            int index = listaAnexosRegistrados.IndexOf(anexo) + 1;
            tituloDocumentoActivo = $"Anexo {index} (Registrado)";
            await VerDocumento(anexo);
        }
        finally
        {
            cargandoPreview = false;
            StateHasChanged();
        }
    }

    private async Task SeleccionarAnexoNuevo(ArchivoAdjunto archi)
    {
        cargandoPreview = true;
