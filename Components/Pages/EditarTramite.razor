    private AsuntoEdicionDto? tramiteOriginal = new();
    private async Task ActualizarDocumento()
    {
        // 1. VALIDACIÓN GENERAL DE CAMPOS OBLIGATORIOS (*)
        string mensajeError = string.Empty;

        if (string.IsNullOrWhiteSpace(tramite?.AsuntoTramite))
        {
            mensajeError = "El campo <strong>Asunto / Sumilla</strong> es obligatorio y no puede estar vacío.";
        }
        else if (tramite.iCodTipoDoc <= 0)
        {
            mensajeError = "Debe seleccionar un <strong>Tipo de Documento</strong> válido.";
        }
        else if (string.IsNullOrWhiteSpace(tramite.NroDocumento))
        {
            mensajeError = "El campo <strong>Nro Documento</strong> es obligatorio.";
        }
        else if (!int.TryParse(tramite.FoliosDocumento, out int foliosNum) || foliosNum <= 0)
        {
            mensajeError = "El campo <strong>Folio</strong> debe ser un número válido mayor a 0.";
        }
        else if (tramite.FechaDocumento == default || tramite.FechaDocumento == DateTime.MinValue)
        {
            mensajeError = "Debe ingresar una <strong>Fecha del Documento</strong> válida.";
        }

        // Si hay algún error de validación, mostramos la alerta y detenemos el proceso
        if (!string.IsNullOrEmpty(mensajeError))
        {
            await SweetAlertHelper.MostrarModalValidacionAsync(
                JSRuntime,
                titulo: "Campos Incompletos",
                mensajeError: "Por favor, complete los campos obligatorios de la información del documento antes de continuar.",
                etiquetaValidacion: "Faltan datos obligatorios",
                mensajeSugerencia: "Verifique que los campos marcados con asterisco (*) tengan información válida."
            );
            return;
        }

        // 2. DIÁLOGO DE CONFIRMACIÓN SI TODO ESTÁ CORRECTO
        var confirmResult = await SweetAlertHelper.MostrarModalConfirmacionAsync(
            JSRuntime,
            "Información del Documento", // Título
            "Mesa de Partes Virtual", //Sub Título
            "Está a punto de modificar la información registrada de este documento en el sistema.", // Mensaje Principal
            "Sí, actualizar", // Botón accíón
            "Actualizar datos del documento", //Estado de la Selección
            "Verifique que la información sea correcta antes de confirmar.", // Mensaje Secundario
            "📁" // Ícono
        );
          
        if (confirmResult.IsConfirmed)
        {
            try
            {
                // 3. DETECTAR QUÉ CAMPOS FUERON MODIFICADOS
                tramite.CambiosRealizados = new List<string>();

                if (tramiteOriginal != null && tramite != null)
                {
                    if (tramite.AsuntoTramite != tramiteOriginal.AsuntoTramite)
                        tramite.CambiosRealizados.Add("El Asunto / Resumen del documento fue modificado.");

                    if (tramite.iCodTipoDoc != tramiteOriginal.iCodTipoDoc)
                        tramite.CambiosRealizados.Add("El Tipo de Documento fue actualizado.");

                    if (tramite.NroDocumento != tramiteOriginal.NroDocumento)
                        tramite.CambiosRealizados.Add("El Número de Documento fue actualizado.");

                    if (tramite.FechaDocumento != tramiteOriginal.FechaDocumento)
                        tramite.CambiosRealizados.Add("La Fecha del Documento fue modificada.");

                    if (tramite.RefDocumento != tramiteOriginal.RefDocumento)
                        tramite.CambiosRealizados.Add("La Referencia fue actualizada.");

                    if (tramite.FoliosDocumento != tramiteOriginal.FoliosDocumento)
                        tramite.CambiosRealizados.Add("El Número de Páginas / Folios fue modificado.");
                }

                // 4. ENVIAR EL OBJETO COMPLETO A LA API
                var response = await Http.PutAsJsonAsync("api/documentos/actualizar-datos-documento", tramite);

                if (response.IsSuccessStatusCode)
                {
                    if (tramite != null && tramiteOriginal != null)
                    {
                        tramiteOriginal.AsuntoTramite = tramite.AsuntoTramite;
                        tramiteOriginal.iCodTipoDoc = tramite.iCodTipoDoc;
                        tramiteOriginal.NroDocumento = tramite.NroDocumento;
                        tramiteOriginal.FechaDocumento = tramite.FechaDocumento;
                        tramiteOriginal.RefDocumento = tramite.RefDocumento;
                        tramiteOriginal.FoliosDocumento = tramite.FoliosDocumento;
                    }

                    // 2. Alerta de éxito con los dos botones de decisión
                    var successResult = await SweetAlertHelper.MostrarModalExitoAccionAsync(
                                            JSRuntime,
                                            "¡Documento Actualizado!", // Título
                                            "Mesa de Partes Virtual", //Sub Título
                                            "Los datos del documento se han procesado y actualizado correctamente en el sistema. ¿Deseas enviar el trámite para levantar la observación o prefieres seguir editando?", // Mensaje Principal
                                            "Guardado parcial", //Estado de la Selección
                                            "Enviar Trámite Subsanado", // Botón accíón
                                            "Seguir editando",
                                            "Esta acción actualizará los datos. Podrás seguir editando o enviar el trámite al finalizar.", // Mensaje Secundario
                                            "📄" // Ícono
                                        );
                                         
                    // 3. Evaluamos la decisión del usuario
                    if (successResult.IsConfirmed)
                    {
                        // Dispara directamente tu función de ActualizarEstado() (la que cambia el estado y levanta la observación)
                        await ActualizarEstado();
                    }
                    else if (successResult.IsDenied)
                    {
                        // Simplemente se queda en la vista actual para seguir editando otros módulos
                        Console.WriteLine("[DEBUG] El usuario optó por seguir editando.");
                    }
                                      
                }
                else
                {
                    string errorDetails = await response.Content.ReadAsStringAsync();
                    Console.WriteLine($"[ERROR API] {errorDetails}");
                    await SweetAlertHelper.MostrarModalErrorAsync(
                        JSRuntime,
                        "Error de Actualización",
                        "Mesa de Partes Virtual",
                        "No se pudo completar la actualización de los datos del documento en el servidor.",
                        textoBotonConfirmar: "Entendido",
                        etiquetaAccion: "Actualización fallida",
                        mensajeAlerta: "Verifique su conexión o intente nuevamente más tarde.",
                        icono: "⚠️"
                    );
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[Blazor Error] {ex.Message}"); 
            }
        }
    }

