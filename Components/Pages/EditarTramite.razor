@layout MainLayout
@page "/EditarTramite/{idAsunto:int}"
@inject HttpClient Http
@inherits PageBase
@inject IJSRuntime JSRuntime

@inject IConfiguration Configuration

<PageTitle>Mesa de Partes Virtual - Editar Trámite</PageTitle>

<div class="ux-bg-t">
    <div class="ux-container-t">
        <div class="ux-hero-t">
            <div class="ux-badge-top-t">Modo Edición</div>
            <h1>CÓDIGO DE TRÁMITE: @(tramite?.CodigoTramite ?? idAsunto.ToString())</h1>
            <p class="ux-description-t">Actualiza la información necesaria y mantén tu expediente al día.</p>
        </div>

        @if (tramite != null)
        {
            <!-- Información del Expediente -->
            <div class="ux-card-form">
                <h2>Información del Expediente</h2>
                <div class="form-grid-t">
                    <div class="form-group-t">
                        <label>Tipo de Trámite</label>
                        <select @bind="tramite.TipoTramite" class="ux-select" disabled>
                            <option value="0">Seleccione...</option>
                            <option value="1">Persona Jurídica</option>
                            <option value="2">Persona Natural</option>
                        </select>
                    </div>

                    @if (tramite.TipoTramite == 1)
                    {
                        <div class="form-group-t animate-fade-in span-two">
                            <label>RUC *</label>
                            <div class="ux-input-group">
                                <input @bind="tramite.RucTramite"
                                       @oninput="OnRucInputChanged"
                                       placeholder="Ingrese RUC"
                                       maxlength="11"
                                       onkeypress="return event.charCode >= 48 && event.charCode <= 57"
                                       disabled="@isProcessing" />

                                <button type="button"
                                        class="ux-btn-action"
                                        @onclick="ValidarRuc"
                                        disabled="@isProcessing">
                                    @(isProcessing ? "Validando..." : "Validar")
                                </button>
                            </div>

                            @if (!string.IsNullOrEmpty(razonSocial))
                            {
                                <div class="ruc-feedback text-success">
                                    <strong>Empresa:</strong> @razonSocial
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(rucErrorMsg))
                            {
                                <div class="ruc-feedback text-error">
                                    @rucErrorMsg
                                </div>
                            }
                        </div>
                    }

                    <div class="form-group-t">
                        <label>Correo de Seguimiento</label>
                        <input type="email" class="form-control-t" @bind="tramite.CorreoTramite" style="text-transform: uppercase;" />
                    </div>

                    @* <div class="form-group-t">
                        <label>Dependencia</label>
                        <input type="text" class="form-control-t" value="@tramite.NombreDependencia" disabled />
                    </div> *@

                    <div class="form-group-t">
                        <label>Estado Actual</label>
                        <div class="estado-display">@tramite.EstadoTramite</div>
                    </div>
                    <div class="form-group-t">
                        <label>Fecha de Creación</label>
                        <div class="estado-display">@tramite.Fecha</div>
                    </div>
                </div>

                <div class="ux-actions-section">
                    <button class="ux-button-small" @onclick="ActualizarExpediente">
                        Actualizar Datos del Expediente
                    </button>
                </div>
            </div>

            <!-- Información del Documento -->
            <div class="ux-card-form">
                <h2>Información del Documento</h2>
                <div class="form-grid-t">
                    <div class="form-group-t span-two">
                        <label>Asunto / Sumilla *</label>
                        <textarea class="form-control-t"
                                  maxlength="255"
                                  @bind="tramite.AsuntoTramite"
                                  placeholder="Ingrese el resumen o asunto del documento..."
                                  style="text-transform: uppercase; resize: vertical; min-height: 80px;">
                            </textarea>
                    </div>
                    <div class="form-group-t">
                        <label>Tipo de Documento *</label>
                        <select @bind="tramite.iCodTipoDoc">
                            <option value="0">--SELECCIONAR--</option>
                            @foreach (var doc in listaTiposDocumento)
                            {
                                <option value="@doc.iCodTipoDoc">@doc.vNombreTipoDoc</option>
                            }
                        </select>
                    </div>
                    <div class="form-group-t">
                        <label>Nro Documento * </label>
                        <input placeholder="Ej: 001-2024" @bind="tramite.NroDocumento" style="text-transform: uppercase;" />
                    </div>
                    <div class="form-group-t">
                        <label>Folio *</label>
                        <input @bind="tramite.FoliosDocumento" placeholder="Ej: 15" onkeypress="return event.charCode >= 48 && event.charCode <= 57" />
                    </div>
                    <div class="form-group-t">
                        <label>Fecha del Documento *</label>
                        <input type="date" @bind="tramite.FechaDocumento" />
                    </div>
                    <div class="form-group-t span-two">
                        <label>Referencia</label>
                        <input @bind="tramite.RefDocumento" placeholder="Ej: Exp. Anterior N° 4521" style="text-transform: uppercase;" />
                    </div>
                </div>

                <div class="ux-actions-section">
                    <button class="ux-button-small" @onclick="ActualizarDocumento">
                        Actualizar Datos del Documento
                    </button>
                </div>
            </div>

            <!-- Documento Adjunto -->
            <div class="ux-card-form">
                <h2>Documento Adjunto</h2>
                <p class="text-muted mb-4" style="font-size: 0.9rem;">Gestione el documento principal y cargue una versión de subsanación de ser necesario.</p>

                <!-- GUÍA VISUAL -->
                <div class="p-3 rounded-4 mb-4" style="background-color: #f8fafc; border: 1px solid #e2e8f0; font-size: 0.88rem; color: #475569;">
                    <div class="fw-bold text-dark mb-1 d-flex align-items-center gap-2">
                        <span>💡</span> <span>Panel de Control de Expediente:</span>
                    </div>
                    La columna izquierda le permite revisar el estado actual y adjuntar archivos nuevos, los cuales se previsualizan instantáneamente a la derecha.
                </div>

                <!-- CONTENEDOR 2 COLUMNAS -->
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; align-items: start;">

                    <!-- COLUMNA IZQUIERDA -->
                    <div style="display: flex; flex-direction: column; gap: 16px;">

                        <!-- DOCUMENTO ACTUAL -->
                        <div class="p-4 rounded-4 bg-white border shadow-sm" style="border-color: #e2e8f0 !important;">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="fw-bold text-dark" style="font-size: 0.95rem;">📂 Documento Principal</span>
                                <span class="badge bg-secondary bg-opacity-10 text-secondary" style="font-size: 0.72rem;">Registrado</span>
                            </div>
                            @if (!string.IsNullOrEmpty(tramite?.RutaDocumento))
                            {
                                <p class="text-muted mb-0" style="font-size: 0.85rem;">El archivo se encuentra sincronizado y cargado en el visor derecho.</p>
                            }
                            else
                            {
                                <span class="text-muted" style="font-size: 0.85rem;">Sin archivo principal en servidor.</span>
                            }
                        </div>

                        <!-- ZONA DE CARGA -->
                        <div class="upload-container text-center p-4 rounded-4 bg-white border border-2 shadow-sm" style="border-style: dashed !important; border-color: #cbd5e1 !important;">
                            <div class="mb-2 text-primary" style="font-size: 1.8rem;">📤</div>
                            <label for="fileUpload" class="ux-button-small file-label-btn d-inline-flex align-items-center gap-2 mb-2 shadow-sm cursor-pointer" style="font-size: 0.9rem;">
                                Seleccionar Archivo Subsanado
                            </label>
                            <InputFile OnChange="OnFileSelected" accept=".pdf" id="fileUpload" class="hidden-input" style="display: none;" />
                            <span class="text-muted d-block" style="font-size: 0.78rem;">Formato PDF • Máx. 50MB</span>
                        </div>

                        <!-- ARCHIVO NUEVO / SUBSANADO (Aparece dinámicamente debajo) -->
                        @if (archivo != null && archivo.Contenido != null && archivo.Contenido.Length > 0)
                        {
                            <div class="p-3 rounded-4 bg-success bg-opacity-10 border border-success border-opacity-25 shadow-sm animate-fade-in">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="badge bg-success text-white" style="font-size: 0.72rem;">Nuevo Subsanado</span>
                                    <button type="button" class="btn btn-sm btn-link text-danger text-decoration-none fw-bold p-0" style="font-size: 0.8rem;" @onclick="RemoverArchivoNuevo">✕ Quitar</button>
                                </div>
                                @* <div class="fw-bold text-success text-truncate" style="font-size: 0.88rem;" title="@archivo.Nombre">
                                    📄 @archivo.Nombre
                                </div> *@
                                <div class="fw-bold text-success text-truncate" style="font-size: 0.88rem;" title="@archivo.Nombre">
                                    📄 Documento Subsanado
                                </div>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(error))
                        {
                            <div class="alert alert-danger bg-danger bg-opacity-10 text-danger border-0 p-3 rounded-4 mb-0" style="font-size: 0.85rem;">
                                @error
                            </div>
                        }
                    </div>

                    <!-- COLUMNA DERECHA: VISOR -->
                    <div style="display: flex; flex-direction: column;">
                        <div class="d-flex justify-content-between align-items-center mb-2 px-1">
                            <span class="fw-bold text-dark" style="font-size: 0.95rem;">Visualizando:</span>
                            @if (!string.IsNullOrEmpty(pdfActualBlobUrl) && !cargandoPreview && !mostrarErrorModal)
                            {
                                @* <a href="@pdfActualBlobUrl" target="_blank" class="text-decoration-none text-primary fw-semibold" style="font-size: 0.8rem;">
                                    Pantalla Completa ↗
                                </a> *@
                                <a href="@pdfActualBlobUrl" target="_blank" class="ux-button-small" style="font-size: 0.8rem; padding: 4px 10px; text-decoration: none;">
                                    🔗 Pantalla Completa
                                </a>
                            }
                        </div>

                        <div class="rounded-4 overflow-hidden shadow-sm border bg-dark" style="width: 100%; height: 520px; border-color: #e2e8f0 !important;">
                            @if (cargandoPreview)
                            {
                                <div class="d-flex flex-column align-items-center justify-content-center h-100 text-center p-5 bg-white w-100">
                                    <div class="spinner-border text-primary mb-2" role="status"></div>
                                    <span class="text-muted" style="font-size: 0.9rem;">Cargando documento...</span>
                                </div>
                            }
                            else if (mostrarErrorModal)
                            {
                                <div class="d-flex flex-column align-items-center justify-content-center h-100 text-center p-4 bg-white w-100">
                                    <div class="rounded-circle bg-warning bg-opacity-15 text-warning d-flex align-items-center justify-content-center mb-3 shadow-sm" style="width: 60px; height: 60px; font-size: 1.8rem;">⚠️</div>
                                    <h6 class="fw-bold text-dark mb-1">Archivo no disponible</h6>
                                    <p class="text-muted mb-2" style="font-size: 0.82rem;">No se encontró el archivo físico en el servidor.</p>
                                    <span class="text-secondary" style="font-size: 0.75rem;">Soporte: (01) 2058030 Anexo 0105</span>
                                </div>
                            }
                            else if (!string.IsNullOrEmpty(pdfPreviewUrl) || !string.IsNullOrEmpty(pdfActualBlobUrl))
                            {
                                <iframe src="@(archivo != null && archivo.Contenido != null && archivo.Contenido.Length > 0 ? pdfPreviewUrl : pdfActualBlobUrl)" style="width: 100%; height: 100%; border: none;"></iframe>
                            }
                            else
                            {
                                <div class="d-flex flex-column align-items-center justify-content-center h-100 text-center p-4 bg-white w-100 text-muted" style="font-size: 0.88rem;">
                                    Seleccione un documento para visualizarlo.
                                </div>
                            }
                        </div>
                    </div>

                </div>

                <div class="ux-actions-section mt-4 pt-3 border-top">
                    <button class="ux-button-small shadow-sm" @onclick="ActualizarDocumentoAdjunto">
                        Actualizar Documento Adjunto
                    </button>
                </div>
            </div>

            <!-- Anexos del Trámite -->
            <div class="ux-card-form">
                <h2>Anexos del Trámite</h2>

                <!-- LEYENDA Y GUÍA RÁPIDA -->
                <div class="alert alert-success bg-success-subtle border-0 p-3.5 rounded-3 mb-4" style="font-size: 0.9rem; line-height: 1.5;">
                    <div class="fw-bold text-success mb-1" style="font-size: 0.95rem;">💡 Leyenda y Guía de Anexos:</div>
                    <ul class="mb-0 ps-3 text-secondary" style="font-weight: 500;">
                        <li><strong>🔍 Ver / Activo:</strong> Seleccione cualquier tarjeta para previsualizar el documento en el panel derecho.</li>
                        <li><strong>✕ Eliminar / Quitar:</strong> Retira el archivo del expediente o de la lista de pendientes.</li>
                    </ul>
                </div>

                <!-- ZONA DE CARGA ESTILO TARJETA -->
                <div class="form-grid-t" style="margin-bottom: 25px;">
                    <div class="form-group-t span-two text-center p-4 rounded-4 border bg-light" style="border-color: #cbd5e1 !important;">
                        <label for="fileUploadMulti" class="ux-button-small file-label-btn d-inline-flex align-items-center gap-2 mb-2" style="cursor: pointer; font-size: 1rem;">
                            📁 Seleccionar Nuevos Archivos PDF
                        </label>
                        <InputFile id="fileUploadMulti"
                                   multiple class="hidden-input"
                                   accept=".pdf"
                                   OnChange="HandleFilesSelected"
                                   style="display: none;" />

                        <div class="ux-file-hint text-muted d-block mt-2" style="font-size: 0.85rem;">
                            (Peso máximo por archivo: <strong>20MB</strong> | Formato: <strong>PDF</strong> | Máximo: <strong>10 anexos</strong>)
                        </div>

                        @if (!string.IsNullOrEmpty(errorArchivo))
                        {
                            <div class="ux-error mt-3 p-2.5 rounded-lg text-start" style="color: #dc3545; background-color: #f8d7da; border: 1px solid #f5c6cb; font-size: 0.9rem;">
                                <strong>⚠️ ¡Atención!</strong> @errorArchivo
                            </div>
                        }
                    </div>
                </div>

                <!-- CONTENEDOR PRINCIPAL EN DOS COLUMNAS (ESTILO VISOR) -->
                <div style="display: grid; grid-template-columns: 350px 1fr; gap: 20px; align-items: start;">

                    <!-- PANEL IZQUIERDO: LISTA DE TARJETAS DE ANEXOS -->
                    <div style="display: flex; flex-direction: column; gap: 16px;">

                        <!-- SECCIÓN 1: REGISTRADOS -->
                        <div>
                            <h3 style="font-size: 1rem; margin-bottom: 10px; color: #333; font-weight: 600;">Documentos Ya Registrados</h3>
                            <div style="display: flex; flex-direction: column; gap: 8px;">
                                @if (listaAnexosRegistrados != null && listaAnexosRegistrados.Any())
                                {
                                    int indexReg = 1;
                                    @foreach (var anexo in listaAnexosRegistrados)
                                    {
                                        var nombreVisual = $"Anexo {indexReg++}";
                                        var esActivo = anexoSeleccionadoRegistrado?.iCodDoc == anexo.iCodDoc;

                                        <div @onclick="() => SeleccionarAnexoRegistrado(anexo)"
                                             style="padding: 12px 16px; background: @(esActivo ? "#f0fdf4" : "#ffffff"); border: 1px solid @(esActivo ? "#10b981" : "#e2e8f0"); border-radius: 10px; cursor: pointer; transition: all 0.2s; box-shadow: 0 1px 2px rgba(0,0,0,0.02); display: flex; align-items: center; justify-content: space-between;">
                                            <div style="display: flex; align-items: center; gap: 10px;">
                                                <span style="font-size: 1.2rem;">📄</span>
                                                <div>
                                                    <div style="font-weight: 600; color: #1e293b; font-size: 0.9rem;">@nombreVisual</div>
                                                    <span style="font-size: 0.75rem; color: #059669; font-weight: 500;">PDF (Registrado)</span>
                                                </div>
                                            </div>
                                            <div style="display: flex; align-items: center; gap: 6px;">
                                                @if (esActivo)
                                                {
                                                    <span style="background: #059669; color: white; padding: 2px 8px; border-radius: 12px; font-size: 0.7rem; font-weight: 600;">Activo</span>
                                                }
                                                <button class="btn-delete" @onclick:stopPropagation="true" @onclick="() => EliminarAnexoRegistrado(anexo.iCodDoc, nombreVisual)" style="background: transparent; border: none; color: #ef4444; cursor: pointer; font-size: 0.9rem;" title="Eliminar">
                                                    ✕
                                                </button>
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div style="padding: 16px; text-align: center; color: #64748b; font-style: italic; font-size: 0.85rem; background: #f8fafc; border: 1px dashed #cbd5e1; border-radius: 8px;">
                                        No hay documentos registrados.
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- SECCIÓN 2: NUEVOS ANEXOS -->
                        <div style="margin-top: 10px;">
                            <h3 style="font-size: 1rem; margin-bottom: 10px; color: #333; font-weight: 600;">Nuevos Anexos por Subir</h3>
                            <div style="display: flex; flex-direction: column; gap: 8px;">
                                @if (archivosNuevos != null && archivosNuevos.Any())
                                {
                                    int indexNuevo = 1;
                                    @foreach (var archi in archivosNuevos)
                                    {
                                        var esActivoNuevo = archivoSeleccionadoNuevo?.Nombre == archi.Nombre;

                                        <div @onclick="() => SeleccionarAnexoNuevo(archi)"
                                             style="padding: 12px 16px; background: @(esActivoNuevo ? "#eff6ff" : "#ffffff"); border: 1px solid @(esActivoNuevo ? "#3b82f6" : "#e2e8f0"); border-radius: 10px; cursor: pointer; transition: all 0.2s; box-shadow: 0 1px 2px rgba(0,0,0,0.02); display: flex; align-items: center; justify-content: space-between;">
                                            <div style="display: flex; align-items: center; gap: 10px; overflow: hidden;">
                                                <span style="font-size: 1.2rem;">📎</span>
                                                <div style="overflow: hidden;">
                                                    <div style="font-weight: 600; color: #1e293b; font-size: 0.85rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="@archi.Nombre">@indexNuevo. @archi.Nombre</div>
                                                    <span style="font-size: 0.7rem; color: #1d4ed8; background: #eff6ff; padding: 1px 6px; border-radius: 4px; font-weight: 600;">Nuevo PDF</span>
                                                </div>
                                            </div>
                                            <div style="display: flex; align-items: center; gap: 6px;">
                                                @if (esActivoNuevo)
                                                {
                                                    <span style="background: #2563eb; color: white; padding: 2px 8px; border-radius: 12px; font-size: 0.7rem; font-weight: 600;">Activo</span>
                                                }
                                                <button class="btn-delete" @onclick:stopPropagation="true" @onclick="() => EliminarArchivoLocal(archi)" style="background: transparent; border: none; color: #ef4444; cursor: pointer; font-size: 0.9rem;" title="Quitar">
                                                    ✕
                                                </button>
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div style="padding: 16px; text-align: center; color: #64748b; font-style: italic; font-size: 0.85rem; background: #f8fafc; border: 1px dashed #cbd5e1; border-radius: 8px;">
                                        No hay nuevos archivos seleccionados.
                                    </div>
                                }
                            </div>
                        </div>

                    </div>

                    <!-- PANEL DERECHO: VISOR / PREVIEW INTEGRADO -->
                    <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; height: 550px; display: flex; flex-direction: column; overflow: hidden; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
                        <div style="padding: 14px 20px; background: #f8fafc; border-bottom: 1px solid #e2e8f0; display: flex; justify-content: space-between; align-items: center;">
                            <span style="font-weight: 600; color: #1e293b; font-size: 0.95rem;">
                                Visualizando: <span style="color: #059669;">@(tituloDocumentoActivo ?? "Ningún documento seleccionado")</span>
                            </span>

                            @if (!string.IsNullOrEmpty(previewUrl))
                            {
                                <a href="@previewUrl" target="_blank" class="ux-button-small" style="font-size: 0.8rem; padding: 4px 10px; text-decoration: none;">
                                    🔗 Pantalla Completa
                                </a>
                            }
                        </div>

                        <div style="flex: 1; display: flex; align-items: center; justify-content: center; background: #f1f5f9; position: relative;">
                            @if (cargandoPreview)
                            {
                                <div class="d-flex flex-column align-items-center justify-content-center h-100 text-center p-4 bg-white w-100">
                                    <div class="spinner-border text-primary mb-3" role="status" style="width: 3rem; height: 3rem;">
                                        <span class="visually-hidden">Cargando...</span>
                                    </div>
                                    <h5 class="fw-bold text-dark mb-1" style="font-size: 1.05rem;">Cargando vista previa...</h5>
                                    <p class="text-muted mb-0" style="font-size: 0.85rem;">Por favor, espere un momento.</p>
                                </div>
                            }
                            else if (string.IsNullOrEmpty(previewUrl))
                            {
                                <div style="text-align: center; color: #64748b; padding: 20px;">
                                    <div style="font-size: 2.5rem; margin-bottom: 10px;">📋</div>
                                    <h5 style="font-size: 1rem; font-weight: 600; color: #334155; margin-bottom: 5px;">Seleccione un documento</h5>
                                    <p style="font-size: 0.85rem; max-width: 250px; margin: 0 auto;">Haga clic en cualquiera de las tarjetas de la izquierda para cargarlo en el visor.</p>
                                </div>
                            }
                            else if (mostrarErrorModal)
                            {
                                <div class="d-flex flex-column align-items-center justify-content-center h-100 text-center p-4 bg-white w-100">
                                    <div class="rounded-circle bg-warning bg-opacity-15 text-warning d-flex align-items-center justify-content-center mb-3 shadow-sm" style="width: 70px; height: 70px; font-size: 2rem; border: 2px solid rgba(245, 158, 11, 0.2);">
                                        ⚠️
                                    </div>
                                    <h5 class="fw-bold text-dark mb-2" style="font-size: 1.15rem;">Documento no encontrado</h5>
                                    <p class="text-muted mb-3" style="max-width: 350px; font-size: 0.88rem; line-height: 1.4;">
                                        El archivo físico no se encuentra disponible en el servidor. Comuníquese con el <strong>área de soporte</strong>.
                                    </p>
                                    <div class="p-2.5 rounded-3 bg-light border shadow-sm d-inline-flex align-items-center gap-2 text-secondary" style="font-size: 0.8rem; border-color: #e2e8f0 !important;">
                                        <span>📞</span> Soporte: <strong class="text-dark">(01) 2058030 Anexo 0105</strong>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <iframe src="@previewUrl" style="width: 100%; height: 100%; border: none;"></iframe>
                            }
                        </div>
                    </div>

                </div>

                <div class="ux-actions-section" style="margin-top: 25px;">
                    <button class="ux-button-small" @onclick="ActualizarDocumentoAnexos">
                        Subir Nuevos Anexos
                    </button>
                </div>
            </div>

            <!-- Botones de Acción Globales -->
            <div class="ux-actions-fixed">
                <button class="ux-button-secondary" @onclick='() => Ir($"/Tramitar")'>Cancelar</button>
                <button class="ux-button" @onclick="GuardarCambios">Actualizar Trámite</button>
            </div>
        }
    </div>
</div>
 

@code {

    [Parameter] public int idAsunto { get; set; }
    private AsuntoEdicionDto? tramite;
