@page "/login"

@layout EmptyLayout
@rendermode InteractiveServer
@inject Models.UserSession Session
@inherits PageBase
@inject HttpClient Http
@inject IJSRuntime JS
@inject MesaPartesDigital.Services.SessionService SessionService
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage SessionStorage

<PageTitle>Mesa de Partes Virtual - Iniciar Sesión</PageTitle>

<div class="neo-login-wrapper">
    <div class="neo-ambient-glow"></div>

    <!-- CONTENEDOR PRINCIPAL ASIMÉTRICO -->
    <div class="neo-main-container animate-fade-in">

        <!-- PANEL IZQUIERDO: INFORMACIÓN INSTITUCIONAL MODERNA -->
        <section class="neo-left-panel">
            <div class="neo-left-content">
                <img src="img/logomax_agrorural.png" alt="Logo Agro Rural" class="neo-logo" />

                <div class="neo-badge-tag">Mesa de Partes Virtual</div>

                <h2>Agilidad, transparencia y<br /><strong>trámites sin barreras</strong></h2>

                <p>
                    Esta entidad pone a su disposición la Mesa de Partes Virtual, un canal diseñado para brindar mayor eficiencia y accesibilidad a sus gestiones administrativas las 24 horas del día.
                </p>

                <div class="neo-info-pill">
                    <span class="neo-pill-icon">📋</span>
                    <span><strong>Ley N° 31465:</strong> Habilitado 24/7 para recepción formal de documentos electrónicos.</span>
                </div>

                <div class="neo-alert-box">
                    <span class="neo-alert-icon">⚠️</span>
                    <div class="neo-alert-text">
                        <strong>Nota de recepción:</strong> El envío no genera aceptación automática; la validación formal se notifica mediante constancia a su correo electrónico.
                    </div>
                </div>

                <footer class="neo-footer-text">
                    Sub Unidad de Tecnologías de la Información — Agro Rural
                </footer>
            </div>
        </section>

        <!-- PANEL DERECHO: ACCESO AL SISTEMA (FORMULARIO DINÁMICO) -->
        <section class="neo-right-panel">
            <div class="neo-form-card">

                <img src="img/logomax_agrorural.png" alt="Logo Agro Rural" class="neo-logo-mobile" />

                <div class="neo-form-header">
                    <h3>Bienvenido</h3>
                    <p>Ingresa tus credenciales para acceder al sistema</p>
                </div>

                @if (!string.IsNullOrEmpty(mensajeAlert))
                {
                    <div class="neo-alert-msg @(esExito ? "msg-success" : "msg-error")">
                        <span>@(esExito ? "✔" : "⚠️")</span>
                        <div>@mensajeAlert</div>
                    </div>
                }

                <EditForm Model="@loginModel" OnValidSubmit="HandleLogin">

                    <div class="neo-floating-group">
                        <div class="neo-input-wrap">
                            <input id="documento" type="text" @bind-value="loginModel.Documento" maxlength="12" placeholder=" " required />
                            <label for="documento">Número de DNI</label>
                            <span class="neo-input-icon">👤</span>
                        </div>
                    </div>

                    <div class="neo-floating-group">
                        <div class="neo-input-wrap">
                            <input id="password" type="password" @bind-value="loginModel.Password" placeholder=" " required />
                            <label for="password">Contraseña</label>
                            <span class="neo-input-icon">🔒</span>
                        </div>
                    </div>

                    <button type="submit" class="neo-submit-btn" disabled="@isProcessing">
                        @if (isProcessing)
                        {
                            <span class="neo-spinner"></span>
                            <span>Validando credenciales...</span>
                        }
                        else
                        {
                            <span>Iniciar Sesión</span>
                        }
                    </button>
                </EditForm>

                <div class="neo-actions-footer">
                    <button type="button" class="neo-link-btn" @onclick="ProcesarRecuperacionClave" disabled="@isProcessing">
                        ¿Olvidaste tu contraseña? Genera una nueva
                    </button>
                </div>

            </div>
        </section>

    </div>
</div>


@code {

    private LoginDto loginModel = new();
    private string mensajeAlert = string.Empty;
    private bool esExito = false;
    private bool isProcessing = false;

    private async Task HandleLogin()
    {
        isProcessing = true;
        mensajeAlert = string.Empty;

        try
        {
            var response = await Http.PostAsJsonAsync("api/autenticacion/login", loginModel);
            var resultado = await response.Content.ReadFromJsonAsync<LoginResultDto>();

            if (resultado?.Exitoso == true)
            {
                string json = System.Text.Json.JsonSerializer.Serialize(resultado);

                // Guardamos en el navegador
                await JS.InvokeVoidAsync("localStorage.setItem", "user_session", json);

                // Actualizamos el servicio en memoria
                SessionService.UserSession = resultado;

                Ir($"/Tramitar");
            }
            else
            {
                mensajeAlert = resultado?.Mensaje ?? "Error al intentar ingresar.";
            }
        }
        catch (Exception)
        {
            mensajeAlert = "Error de conexión con el servidor.";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task ProcesarRecuperacionClave()
    {
        if (string.IsNullOrWhiteSpace(loginModel.Documento))
        {
            mensajeAlert = "Por favor, ingrese su número de DNI.";
            return;
        }

        isProcessing = true;
        mensajeAlert = string.Empty;

        try
        {
            var request = new { Documento = loginModel.Documento, CodigoOtp = (string?)null, TipoAccion = 2 };
            var response = await Http.PostAsJsonAsync("api/autenticacion/credenciales", request);
            var resultado = await response.Content.ReadFromJsonAsync<GestionCredencialesResultDto>();

            if (resultado?.Exitoso == true)
            {
                string emailDestino = resultado.EmailDestino ?? "su correo";

                await JS.InvokeVoidAsync("Swal.fire", new
                {
                    html = $@"
                            <div style='text-align: left; padding: 10px 5px; font-family: system-ui, -apple-system, sans-serif;'>
                                <!-- Cabecera con Icono -->
                                <div style='display: flex; align-items: center; gap: 14px; margin-bottom: 20px;'>
                                    <div style='background-color: #f0fdf4; color: #16a34a; width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 24px; flex-shrink: 0; box-shadow: 0 2px 4px rgba(22, 163, 74, 0.1);'>
                                        📬
                                    </div>
                                    <div>
                                        <h3 style='margin: 0; font-size: 18px; font-weight: 700; color: #1e293b;'>¡Contraseña Actualizada!</h3>
                                        <p style='margin: 2px 0 0 0; font-size: 13px; color: #64748b;'>Seguridad de la Cuenta</p>
                                    </div>
                                </div>

                                <!-- Descripción -->
                                <p style='font-size: 14px; color: #475569; line-height: 1.5; margin-bottom: 15px;'>
                                    Hemos enviado tus nuevas credenciales de acceso de forma segura al siguiente correo:
                                </p>

                                <!-- Tarjeta de Correo Destino -->
                                <div style='background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 16px; margin-bottom: 20px;'>
                                    <div style='font-size: 14px; color: #1e293b; font-weight: 600; font-family: monospace; word-break: break-all; background: #ffffff; padding: 10px 12px; border-radius: 8px; border: 1px dashed #cbd5e1; text-align: center;'>
                                        {emailDestino}
                                    </div>
                                </div>

                                <!-- Nota de ayuda / SPAM -->
                                <div style='display: flex; align-items: flex-start; gap: 8px; font-size: 12px; color: #856404; background: #fff3cd; padding: 10px 12px; border-radius: 8px; border: 1px solid #ffeeba;'>
                                    <span style='flex-shrink: 0;'>⚠️</span>
                                    <span><b>Importante:</b> Si no lo encuentras en tu bandeja principal, revisa tu bandeja de <b>Correo No Deseado o SPAM</b>.</span>
                                </div>
                            </div>
                        ",
                    showConfirmButton = true,
                    confirmButtonText = "¡Entendido, gracias!",
                    confirmButtonColor = "#1e293b",
                    allowOutsideClick = false,
                    backdrop = "rgba(15, 23, 42, 0.5)",
                    customClass = new
                    {
                        popup = "rounded-2xl shadow-xl border border-slate-100"
                    }
                });

                mensajeAlert = string.Empty;
            }
            else
            {
                mensajeAlert = resultado?.Mensaje ?? "Error en la solicitud.";
            }
        }
        catch (Exception)
        {
            mensajeAlert = "Error al conectar con el servidor.";
        }
        finally
        {
            isProcessing = false;
        }
    }

}